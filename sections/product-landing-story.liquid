{%- comment -%}
  Bayel Moss LP — Isolated landing page section
  Scope: #bayel-moss-lp only. Does not affect the rest of the theme.
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign variant_id = current_variant.id
  assign base_price = current_variant.price
  assign default_country = section.settings.default_country | default: 'AE'
  assign wa_number = section.settings.whatsapp_number | default: '971542585701'
  assign hero_image = 'lp-bottle.webp'
  assign price_1 = section.settings.price_1 | default: 189
  assign price_2 = section.settings.price_2 | default: 225
  assign price_3 = section.settings.price_3 | default: 299
  assign compare_1 = section.settings.compare_1 | default: 249
  assign compare_2 = section.settings.compare_2 | default: 299
  assign compare_3 = section.settings.compare_3 | default: 349
-%}

<div
  id="bayel-moss-lp"
  class="bm-lp"
  dir="rtl"
  lang="ar"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle | escape }}"
  data-product-title="{{ product.title | escape }}"
  data-variant-id="{{ variant_id }}"
  data-shop-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}"
  data-default-country="{{ default_country }}"
  data-price-1="{{ price_1 }}"
  data-price-2="{{ price_2 }}"
  data-price-3="{{ price_3 }}"
>

  {%- comment -%} ============ LOCAL HEADER ============ {%- endcomment -%}
  <header class="bm-header">
    <div class="bm-header__inner">
      <a href="#top" class="bm-header__brand" aria-label="بابل موس">
        <span class="bm-header__brand-mark" aria-hidden="true">◆</span>
        <span class="bm-header__brand-name">بابل موس</span>
      </a>
      <nav class="bm-header__nav" aria-label="روابط الصفحة">
        <a href="#top">الرئيسية</a>
        <a href="#lp-how">طريقة الاستخدام</a>
        <a href="#lp-reviews">التقييمات</a>
        <a href="#lp-faq">الأسئلة</a>
      </nav>
      <a href="#lp-order" class="bm-header__cta">اطلب الآن</a>
      <button type="button" class="bm-header__burger" aria-label="القائمة" data-bm-burger>
        <span></span><span></span><span></span>
      </button>
    </div>
    <div class="bm-header__drawer" data-bm-drawer hidden>
      <a href="#top">الرئيسية</a>
      <a href="#lp-how">طريقة الاستخدام</a>
      <a href="#lp-reviews">التقييمات</a>
      <a href="#lp-faq">الأسئلة</a>
      <a href="#lp-order" class="bm-header__drawer-cta">اطلب الآن</a>
    </div>
  </header>

  {%- comment -%} ============ ANNOUNCEMENT BAR ============ {%- endcomment -%}
  <div class="bm-announce">
    <div class="bm-announce__track">
      <span>✦ توصيل ١-٣ أيام لكل الإمارات</span>
      <span>✦ الدفع عند الاستلام</span>
      <span>✦ ضمان استرجاع ٣٠ يوم</span>
      <span>✦ مكونات عشبية ١٠٠٪</span>
      <span>✦ توصيل ١-٣ أيام لكل الإمارات</span>
      <span>✦ الدفع عند الاستلام</span>
      <span>✦ ضمان استرجاع ٣٠ يوم</span>
      <span>✦ مكونات عشبية ١٠٠٪</span>
    </div>
  </div>

  {%- comment -%} ============ HERO ============ {%- endcomment -%}
  <section class="bm-hero" id="top">
    <div class="bm-hero__inner">
      <p class="bm-hero__eyebrow">بابل موس · العناية بشعر الرجل</p>
      <h1 class="bm-hero__title">
        غطِّ الشيب بدقيقة<br>
        <span class="bm-hero__title-em">وارجع لشكلك الأصغر</span>
      </h1>
      <p class="bm-hero__lead">
        موس رغوي عشبي يغطّي الشيب بلون طبيعي غامق من أول استخدام. بدون أمونيا، بدون فوضى، وبدون ما أحد يحس إنه مصبوغ — تسوّيه بنفسك في البيت بدقائق.
      </p>

      <div class="bm-hero__media">
        <div class="bm-hero__orb" aria-hidden="true"></div>
        <div class="bm-hero__badge">
          <span class="bm-hero__badge-num">60٪</span>
          <span class="bm-hero__badge-label">خصم اليوم</span>
        </div>
        <img
          src="{{ hero_image | asset_url }}"
          alt="{{ product.title | escape }}"
          class="bm-hero__image"
          width="520"
          height="760"
          loading="eager"
          fetchpriority="high"
        >
      </div>

      <div class="bm-hero__trust">
        <span class="bm-hero__stars" aria-hidden="true">★★★★★</span>
        <span class="bm-hero__trust-text">٤٫٩ / ٥ · ثقة أكثر من +١٢,٠٠٠ رجّال في الخليج</span>
      </div>

      <a href="#lp-order" class="bm-hero__cta">
        اطلب الآن — {{ price_1 }} درهم
        <span class="bm-hero__cta-arrow" aria-hidden="true">←</span>
      </a>

      <ul class="bm-hero__mini-trust" aria-label="مزايا الطلب">
        <li>✓ الدفع عند الاستلام</li>
        <li>✓ توصيل مجاني للإمارات</li>
        <li>✓ ضمان ٣٠ يوم</li>
      </ul>
    </div>
  </section>

  {%- comment -%} ============ UGC / SOCIAL PROOF ============ {%- endcomment -%}
  <section class="bm-section bm-proof" id="lp-reviews-video">
    <div class="bm-section__head">
      <span class="bm-kicker">ردّات فعل حقيقية ✨</span>
      <h2 class="bm-section__title">رجّال جرّبوا بابل موس وشافوا الفرق</h2>
      <p class="bm-section__sub">فيديوهات حقيقية من عملائنا في الإمارات والخليج — شوف الفرق بعينك.</p>
    </div>

    <div class="bm-ugc" role="region" aria-label="تجارب حقيقية بالفيديو">
      {%- assign videos = 'review-1.mp4,review-2.mp4,review-3-storytelling.mp4,review-4.mp4' | split: ',' -%}
      {%- assign captions = 'صار شكلي أصغر بسنين 🔥,اللون طبيعي وما أحد حس,سويته بالبيت بدقائق,غطّى الشيب من أول مرة 👌' | split: ',' -%}
      {%- for v in videos -%}
        {%- assign idx = forloop.index0 -%}
        <article class="bm-ugc__card" data-ugc-index="{{ forloop.index }}">
          <div class="bm-ugc__media">
            {%- assign poster_num = forloop.index -%}
            {%- capture poster_file -%}lp-review-{{ poster_num }}-poster.jpg{%- endcapture -%}
            <video
              class="bm-ugc__video"
              playsinline
              muted
              loop
              preload="none"
              controls
              poster="{{ poster_file | asset_url }}"
              data-ugc-video
            >
              <source src="{{ v | asset_url }}" type="video/mp4">
            </video>
            <button type="button" class="bm-ugc__play" data-ugc-play aria-label="تشغيل الفيديو">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            </button>
          </div>
          <div class="bm-ugc__caption">
            <strong>{{ captions[idx] }}</strong>
            <span>عميل موثّق</span>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </section>

  {%- comment -%} ============ OFFERS + FORM ============ {%- endcomment -%}
  <section class="bm-section bm-order" id="lp-order">
    <div class="bm-section__head">
      <span class="bm-kicker">العرض</span>
      <h2 class="bm-section__title">اختر باقتك ووفّر أكثر</h2>
      <p class="bm-section__sub">كل الباقات شحن مجاني + الدفع عند الاستلام. الأسعار بـدرهم إماراتي.</p>
    </div>

    <div class="bm-order__layout">
      {%- comment -%} OFFERS {%- endcomment -%}
      <div class="bm-offers" role="radiogroup" aria-label="اختر الباقة">
        <label class="bm-offer" data-offer="1">
          <input type="radio" name="bm-offer" value="1" data-qty="1" data-price="{{ price_1 }}" data-compare="{{ compare_1 }}">
          <div class="bm-offer__card">
            <div class="bm-offer__head">
              <span class="bm-offer__qty">علبة واحدة</span>
              <span class="bm-offer__hint">توصيل مجاني · الدفع عند الاستلام</span>
            </div>
            <div class="bm-offer__prices">
              <span class="bm-offer__price">{{ price_1 }} <span>درهم</span></span>
              <span class="bm-offer__compare">{{ compare_1 }} درهم</span>
            </div>
            <p class="bm-offer__blurb">خيار مناسب إذا حاب تجرّب المنتج أول مرة.</p>
          </div>
        </label>

        <label class="bm-offer bm-offer--featured" data-offer="2">
          <span class="bm-offer__badge">الأكثر طلباً 🔥</span>
          <input type="radio" name="bm-offer" value="2" data-qty="2" data-price="{{ price_2 }}" data-compare="{{ compare_2 }}" checked>
          <div class="bm-offer__card">
            <div class="bm-offer__head">
              <span class="bm-offer__qty">علبتين</span>
              <span class="bm-offer__hint">توصيل مجاني · الدفع عند الاستلام</span>
            </div>
            <div class="bm-offer__prices">
              <span class="bm-offer__price">{{ price_2 }} <span>درهم</span></span>
              <span class="bm-offer__compare">{{ compare_2 }} درهم</span>
            </div>
            <p class="bm-offer__blurb">الخيار الأكثر طلباً — كمية تكفيك مدة أطول.</p>
          </div>
        </label>

        <label class="bm-offer" data-offer="3">
          <span class="bm-offer__badge bm-offer__badge--gold">أفضل قيمة 👑</span>
          <input type="radio" name="bm-offer" value="3" data-qty="3" data-price="{{ price_3 }}" data-compare="{{ compare_3 }}">
          <div class="bm-offer__card">
            <div class="bm-offer__head">
              <span class="bm-offer__qty">٣ علب</span>
              <span class="bm-offer__hint">توصيل مجاني · الدفع عند الاستلام</span>
            </div>
            <div class="bm-offer__prices">
              <span class="bm-offer__price">{{ price_3 }} <span>درهم</span></span>
              <span class="bm-offer__compare">{{ compare_3 }} درهم</span>
            </div>
            <p class="bm-offer__blurb">أفضل قيمة — كمية أكبر بسعر أوفر.</p>
          </div>
        </label>
      </div>

      {%- comment -%}
        FORM — Compatible EasySell COD Form & Upsells.
        EasySell détecte automatiquement les form[action="/cart/add"] avec un bouton
        [name="add"] et ouvre son popup au clic — nous ne collectons donc PAS les
        infos client ici (nom/téléphone/adresse). EasySell s'en charge dans son propre popup.
      {%- endcomment -%}
      <form
        method="post"
        action="{{ routes.cart_add_url }}"
        class="bm-form bm-form--easysell"
        id="bm-order-form"
        accept-charset="UTF-8"
        enctype="multipart/form-data"
        data-product-form
        data-easysell-form
      >
        <input type="hidden" name="form_type" value="product">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="id" value="{{ variant_id }}" data-bm-variant>
        <input type="hidden" name="quantity" value="2" data-bm-quantity>
        <input type="hidden" name="properties[Offer]" value="2 units" data-bm-offer-prop>
        <input type="hidden" name="properties[Country]" value="AE" data-bm-country-prop>

        <div class="bm-form__head">
          <h3 class="bm-form__title">اطلب الآن — الدفع عند الاستلام</h3>
          <p class="bm-form__sub">اختَر الباقة المناسبة، ثم اضغط الزر واملأ بياناتك في النافذة. فريقنا بيتواصل معك لتأكيد الطلب — ما يصير أي دفع الحين.</p>
        </div>

        <ul class="bm-form__benefits" aria-label="مزايا الطلب">
          <li><span aria-hidden="true">💵</span> ادفع كاش لما يوصلك الطلب</li>
          <li><span aria-hidden="true">🚚</span> توصيل مجاني داخل الإمارات</li>
          <li><span aria-hidden="true">🔒</span> ضمان استرجاع ٣٠ يوم</li>
        </ul>

        <div class="bm-notice">📍 التوصيل داخل الإمارات — الأسعار بـدرهم إماراتي</div>

        <button
          type="submit"
          name="add"
          class="bm-form__cta"
          data-bm-submit
        >
          <span class="bm-form__cta-icon" aria-hidden="true">🛒</span>
          <span data-bm-cta-label>اطلب الآن · {{ price_2 }} درهم</span>
          <span class="bm-form__cta-arrow" aria-hidden="true">←</span>
        </button>

        <ul class="bm-form__trust" aria-label="ضمانات">
          <li>✓ الدفع عند الاستلام</li>
          <li>✓ توصيل داخل الإمارات</li>
          <li>✓ تأكيد الطلب قبل الشحن</li>
        </ul>
      </form>
    </div>
  </section>

  {%- comment -%} ============ PROBLEM ============ {%- endcomment -%}
  <section class="bm-section bm-problem">
    <div class="bm-section__head">
      <span class="bm-kicker">المشكلة</span>
      <h2 class="bm-section__title">الشيب يكبّرك بسنين… وانت ما تستاهل</h2>
    </div>

    <div class="bm-problem__grid">
      <figure class="bm-problem__figure">
        <img
          src="{{ 'lp-problem-before.jpg' | asset_url }}"
          alt="رجل يعاني من الشيب قبل استخدام بابل موس"
          width="640"
          height="908"
          loading="lazy"
          decoding="async"
        >
        <figcaption>قبل</figcaption>
      </figure>
      <ul class="bm-problem__list">
        <li><span class="bm-x">✕</span> الشيب يطلع وانت في عز شبابك ويعطيك شكل أكبر من عمرك الحقيقي.</li>
        <li><span class="bm-x">✕</span> الصبغات الكيميائية تضرّ شعرك وتعطي لون صناعي يبيّن من بعيد.</li>
        <li><span class="bm-x">✕</span> الكوافير غالي ومتعب، وتضطر تعيده كل أسبوعين.</li>
        <li><span class="bm-x">✕</span> دايم خايف اللون يبيّن "مصبوغ" قدام أهلك وربعك.</li>
      </ul>
    </div>

    <div class="bm-problem__solution">
      <strong>بابل موس يحلّها من جذرها:</strong>
      رغوة عشبية تغطّي الشيب بلون طبيعي غامق، تطبّقها بنفسك في البيت خلال دقائق — والنتيجة تبان طبيعية ما تنكشف.
    </div>
  </section>

  {%- comment -%} ============ HOW TO USE ============ {%- endcomment -%}
  <section class="bm-section bm-steps" id="lp-how">
    <div class="bm-section__head">
      <span class="bm-kicker">سهل وسريع</span>
      <h2 class="bm-section__title">٤ خطوات وبس</h2>
      <p class="bm-section__sub">بدون فُرَش، بدون قفّازات، وبدون فوضى — تسوّيه بنفسك في البيت.</p>
    </div>

    <ol class="bm-steps__list">
      <li class="bm-step">
        <span class="bm-step__num">١</span>
        <h3>وزّع الرغوة</h3>
        <p>اضغط كمية الرغوة على راحة يدك أو على الشعر مباشرة.</p>
      </li>
      <li class="bm-step">
        <span class="bm-step__num">٢</span>
        <h3>دلّك الشعر</h3>
        <p>افرد الرغوة من الجذور للأطراف على كل المناطق المشيّبة.</p>
      </li>
      <li class="bm-step">
        <span class="bm-step__num">٣</span>
        <h3>اتركها ٥-١٠ دقائق</h3>
        <p>خلّ التركيبة العشبية تشتغل وتغطّي الشيب بالكامل.</p>
      </li>
      <li class="bm-step">
        <span class="bm-step__num">٤</span>
        <h3>اشطفها</h3>
        <p>لون طبيعي غامق فوري — نظيف وبدون أي فوضى.</p>
      </li>
    </ol>
  </section>

  {%- comment -%} ============ INGREDIENTS ============ {%- endcomment -%}
  <section class="bm-section bm-ingredients">
    <div class="bm-section__head bm-section__head--light">
      <span class="bm-kicker bm-kicker--light">من الطبيعة</span>
      <h2 class="bm-section__title">تركيبة عشبية بمكونات فعّالة</h2>
      <p class="bm-section__sub bm-section__sub--light">مكونات طبيعية مختارة بعناية تغطّي الشيب وتعتني بشعرك من غير ما تضرّه.</p>
    </div>

    <ul class="bm-ingredients__chips">
      <li>🍵 مستخلص الشاي الأخضر</li>
      <li>🫐 خلاصة التوت الأسود</li>
      <li>🫚 الجينسنغ</li>
      <li>💧 زيت الأرغان</li>
      <li>🧪 البانثينول B5</li>
      <li>🌵 الصبار</li>
      <li>🌿 عرق السوس</li>
      <li>🌾 بروتين القمح</li>
    </ul>
  </section>

  {%- comment -%} ============ REVIEWS ============ {%- endcomment -%}
  <section class="bm-section bm-reviews" id="lp-reviews">
    <div class="bm-section__head">
      <span class="bm-kicker">آراء عملائنا</span>
      <h2 class="bm-section__title">ثقة آلاف الرجال في الخليج</h2>
      <p class="bm-section__sub">تجارب حقيقية من عملاء استخدموا بابل موس.</p>
    </div>

    <div class="bm-reviews__grid">
      <article class="bm-review">
        <div class="bm-review__stars">★★★★★</div>
        <p>"صار لي سنة أعاني من الشيب وأنا بعدني شاب. جربت بابل موس وصراحة اللون طلع طبيعي وايد، ولا أحد حس إني مغطّي الشيب. خفيف وسهل."</p>
        <footer>
          <img src="{{ 'lp-avatar-1.jpg' | asset_url }}" alt="" width="48" height="48" loading="lazy" decoding="async" class="bm-review__avatar">
          <div class="bm-review__meta">
            <strong>خالد العتيبي</strong>
            <span>الرياض، السعودية · عميل موثّق</span>
          </div>
          <span class="bm-review__verified" aria-label="عميل موثّق">✓</span>
        </footer>
      </article>
      <article class="bm-review">
        <div class="bm-review__stars">★★★★★</div>
        <p>"أحسن شي إنه ما فيه فوضى مثل الصبغات. أستخدمه بالبيت بدقائق والنتيجة من أول مرة. الطلب وصلني خلال يومين ودفعت كاش عند الاستلام."</p>
        <footer>
          <img src="{{ 'lp-avatar-2.jpg' | asset_url }}" alt="" width="48" height="48" loading="lazy" decoding="async" class="bm-review__avatar">
          <div class="bm-review__meta">
            <strong>عبدالله المنصوري</strong>
            <span>دبي، الإمارات · عميل موثّق</span>
          </div>
          <span class="bm-review__verified" aria-label="عميل موثّق">✓</span>
        </footer>
      </article>
      <article class="bm-review">
        <div class="bm-review__stars">★★★★★</div>
        <p>"كنت متردد بالبداية بس الدفع عند الاستلام طمّني. المنتج ممتاز واللون ثابت وما يطلع بسرعة. رجعت طلبت باقة ٣ قطع."</p>
        <footer>
          <img src="{{ 'lp-avatar-3.jpg' | asset_url }}" alt="" width="48" height="48" loading="lazy" decoding="async" class="bm-review__avatar">
          <div class="bm-review__meta">
            <strong>فيصل الشمري</strong>
            <span>الدمام، السعودية · عميل موثّق</span>
          </div>
          <span class="bm-review__verified" aria-label="عميل موثّق">✓</span>
        </footer>
      </article>
    </div>
  </section>

  {%- comment -%} ============ FAQ ============ {%- endcomment -%}
  <section class="bm-section bm-faq" id="lp-faq">
    <div class="bm-section__head">
      <span class="bm-kicker">أسئلة قبل الطلب</span>
      <h2 class="bm-section__title">كل اللي تبي تعرفه</h2>
    </div>

    <div class="bm-faq__list">
      <details class="bm-faq__item">
        <summary>وش يميّز بابل موس عن الصبغات العادية؟</summary>
        <p>بابل موس تركيبة رغوية عشبية بدون أمونيا أو بيروكسيد، تغطّي الشيب بلون طبيعي غامق بدون ما تضرّ شعرك، وبدون الفوضى اللي تجي مع الصبغات العادية.</p>
      </details>
      <details class="bm-faq__item">
        <summary>هل اللون يبان طبيعي ولا يكشف إنه مصبوغ؟</summary>
        <p>اللون يطلع طبيعي ومتجانس مع لون شعرك، وما يبيّن إنه مصبوغ. أغلب عملائنا يقولون إن أحد ما يلاحظ الفرق.</p>
      </details>
      <details class="bm-faq__item">
        <summary>الدفع عند الاستلام متوفر في الإمارات؟</summary>
        <p>نعم، الدفع عند الاستلام متوفر لكل الإمارات. تدفع كاش عند وصول الطلب لباب بيتك.</p>
      </details>
      <details class="bm-faq__item">
        <summary>كم ياخذ التوصيل؟</summary>
        <p>من ١ إلى ٣ أيام عمل داخل الإمارات، مع رسالة تتبّع بعد تأكيد طلبك.</p>
      </details>
      <details class="bm-faq__item">
        <summary>فيه ضمان لو ما عجبتني النتيجة؟</summary>
        <p>أكيد. عندك ضمان استرجاع ٣٠ يوم كامل — لو ما عجبتك النتيجة تواصل معنا ونرجّع لك المبلغ.</p>
      </details>
      <details class="bm-faq__item">
        <summary>كم مرة أستخدمه في الأسبوع؟</summary>
        <p>حسب سرعة ظهور الشيب عندك، بس بشكل عام مرة إلى مرتين في الأسبوع تكفي للمحافظة على اللون.</p>
      </details>
    </div>
  </section>

  {%- comment -%} ============ FINAL CTA ============ {%- endcomment -%}
  <section class="bm-section bm-final">
    <h2>جاهز تودّع الشيب؟</h2>
    <p>اطلب الحين وادفع كاش عند الاستلام. جرّب بابل موس بضمان ٣٠ يوم.</p>
    <a href="#lp-order" class="bm-final__cta">اطلب الآن — ابدأ من {{ price_1 }} درهم</a>
  </section>

  {%- comment -%} ============ FLOATING WHATSAPP ============ {%- endcomment -%}

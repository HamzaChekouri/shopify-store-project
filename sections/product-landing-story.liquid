  /* Mobile only: show burger, hide inline CTA in header on very tight widths */
  @media (max-width: 749px) {
    .bm-header__burger { display: inline-flex; }
    .bm-header__cta {
      padding: 0.55rem 0.95rem;
      font-size: 0.82rem;

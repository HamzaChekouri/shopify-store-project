  If you want to restore the custom backend/Sheet pipeline, restore the block below
  and re-add the customer fields to the form.
{%- endcomment -%}

{% stylesheet %}
  /* ==========================================================================
     BAYEL MOSS LP — Isolated styles
     All rules scoped under #bayel-moss-lp to prevent global bleed.
     ========================================================================== */

  /* Hide legacy sections that persist in the theme editor state for this template.
     Scoped only to Bayel Moss LP template to avoid affecting other pages. */
  body.template-product-bayel-moss-lp .shopify-section:has(> .product-information),
  body.template-product-bayel-moss-lp .shopify-section:has(> .product-recommendations),
  body.template-product-bayel-moss-lp .shopify-section > .product-information,
  body.template-product-bayel-moss-lp .shopify-section > .product-recommendations {
    display: none !important;
  }

  /* Hide the global Shopify theme header + announcement bar ONLY on the Bayel Moss LP
     so the local .bm-header takes over the full experience. */
  body.template-product-bayel-moss-lp #header-component,
  body.template-product-bayel-moss-lp header.header,
  body.template-product-bayel-moss-lp .shopify-section-header,
  body.template-product-bayel-moss-lp .shopify-section-group-header-group,
  body.template-product-bayel-moss-lp .header-wrapper,
  body.template-product-bayel-moss-lp .announcement-bar,
  body.template-product-bayel-moss-lp .utility-bar {
    display: none !important;
  }

  #bayel-moss-lp {
    --bm-bg: #f5efe4;
    --bm-panel: #ffffff;
    --bm-green-dark: #1e4a2b;
    --bm-green: #2f6b3f;
    --bm-green-soft: #d9e8dd;
    --bm-gold: #b48a3a;
    --bm-text: #1f2b21;
    --bm-muted: #5c6b5e;
    --bm-border: rgba(31, 43, 33, 0.10);
    --bm-shadow: 0 12px 30px rgba(20, 40, 25, 0.08);
    --bm-shadow-lg: 0 20px 50px rgba(20, 40, 25, 0.12);
    --bm-radius: 18px;
    --bm-radius-sm: 12px;
    --bm-radius-lg: 24px;

    background: var(--bm-bg);
    color: var(--bm-text);
    font-family: 'DIN Next LT Arabic', 'Almarai', 'Cairo', 'Tajawal', system-ui, -apple-system, Segoe UI, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    direction: rtl;
    text-align: right;
    overflow-x: clip;
    min-height: 100vh;
    position: relative;
    padding-bottom: env(safe-area-inset-bottom);
  }

  #bayel-moss-lp *,
  #bayel-moss-lp *::before,
  #bayel-moss-lp *::after {
    box-sizing: border-box;
  }

  #bayel-moss-lp img,
  #bayel-moss-lp video {
    max-width: 100%;
    display: block;
  }

  #bayel-moss-lp h1,
  #bayel-moss-lp h2,
  #bayel-moss-lp h3,
  #bayel-moss-lp h4,
  #bayel-moss-lp p,
  #bayel-moss-lp ul,
  #bayel-moss-lp ol {
    margin: 0;
    padding: 0;
  }

  #bayel-moss-lp ul,
  #bayel-moss-lp ol {
    list-style: none;
  }

  #bayel-moss-lp a {
    color: inherit;
    text-decoration: none;
  }

  /* ============ RESET BUTTON TEXT to guarantee white on green CTAs
     (overrides any inherited base.css / dawn theme button styles) ============ */
  #bayel-moss-lp .bm-hero__cta,
  #bayel-moss-lp .bm-form__cta,
  #bayel-moss-lp .bm-final__cta,
  #bayel-moss-lp .bm-header__cta,
  #bayel-moss-lp .bm-header__drawer-cta,
  #bayel-moss-lp .bm-offer__badge {
    color: #ffffff !important;
    text-transform: none !important;
    letter-spacing: 0.005em;
    font-family: inherit;
    text-shadow: 0 1px 2px rgba(15, 30, 20, 0.28);
    -webkit-text-fill-color: #ffffff;
  }

  /* ============ LOCAL HEADER ============ */
  .bm-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: #f5efe4;
    border-bottom: 1px solid var(--bm-border);
    box-shadow: 0 1px 0 rgba(20,40,25,0.02);
  }
  .bm-header__inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0.65rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }
  .bm-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 900;
    font-size: 1.1rem;
    color: var(--bm-green-dark);
    letter-spacing: -0.01em;
  }
  .bm-header__brand-mark {
    color: var(--bm-gold);
    font-size: 1.15rem;
    line-height: 1;
    transform: translateY(-1px);
  }
  .bm-header__nav {
    display: none;
    align-items: center;
    gap: 1.4rem;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--bm-text);
  }
  .bm-header__nav a {
    position: relative;
    color: var(--bm-text);
    padding: 0.3rem 0;
    transition: color 0.15s ease;
  }
  .bm-header__nav a::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 2px;
    background: var(--bm-green);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.2s ease;
  }
  .bm-header__nav a:hover { color: var(--bm-green-dark); }
  .bm-header__nav a:hover::after { transform: scaleX(1); }

  .bm-header__cta {
    background: var(--bm-green);
    color: #ffffff;
    padding: 0.62rem 1.2rem;
    border-radius: 999px;
    font-weight: 800;
    font-size: 0.9rem;
    transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
    box-shadow: 0 6px 14px rgba(30, 74, 43, 0.22);
    white-space: nowrap;
  }
  .bm-header__cta:hover {
    background: var(--bm-green-dark);
    transform: translateY(-1px);
    box-shadow: 0 10px 18px rgba(30, 74, 43, 0.3);
  }

  .bm-header__burger {
    display: none;
    background: transparent;
    border: 1px solid var(--bm-border);
    border-radius: 10px;
    width: 42px;
    height: 42px;
    padding: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
  }
  .bm-header__burger span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--bm-green-dark);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .bm-header.is-open .bm-header__burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .bm-header.is-open .bm-header__burger span:nth-child(2) { opacity: 0; }
  .bm-header.is-open .bm-header__burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .bm-header__drawer {
    display: none;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.5rem 1rem 1rem;
    border-top: 1px solid var(--bm-border);
    background: #f5efe4;
  }
  .bm-header__drawer:not([hidden]) { display: flex; }
  .bm-header__drawer a {
    padding: 0.85rem 0.75rem;
    border-radius: 12px;
    font-weight: 700;
    font-size: 0.98rem;
    color: var(--bm-text);
    background: rgba(255,255,255,0.55);
  }
  .bm-header__drawer-cta {
    background: var(--bm-green) !important;
    color: #ffffff !important;
    text-align: center;
    margin-top: 0.35rem;
  }

  /* ============ ANNOUNCE MARQUEE ============ */
  .bm-announce {
    background: var(--bm-green-dark);
    color: #fff;
    overflow: hidden;
    font-size: 0.82rem;
    font-weight: 600;
  }
  .bm-announce__track {
    display: flex;
    gap: 2.5rem;
    padding: 0.5rem 0;
    white-space: nowrap;
    animation: bm-marquee 32s linear infinite;
    width: max-content;
  }
  .bm-announce__track span { flex: none; }
  @keyframes bm-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(50%); }
  }

  /* ============ HERO ============ */
  .bm-hero {
    padding: 1.75rem 1rem 2rem;
  }
  .bm-hero__inner {
    max-width: 640px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
  }
  .bm-hero__eyebrow {
    display: inline-block;
    color: var(--bm-green);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    text-transform: none;
    padding: 0.35rem 0.85rem;
    background: var(--bm-green-soft);
    border-radius: 999px;
  }
  .bm-hero__title {
    font-size: clamp(2rem, 7.5vw, 3.1rem);
    font-weight: 900;
    line-height: 1.15;
    color: var(--bm-text);
    letter-spacing: -0.01em;
  }
  .bm-hero__title-em {
    color: var(--bm-green-dark);
  }
  .bm-hero__lead {
    color: var(--bm-muted);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 34ch;
  }
  .bm-hero__media {
    position: relative;
    width: min(320px, 78%);
    margin: 0.5rem auto;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .bm-hero__orb {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 45%, #cfe4d4 0%, #b6d2be 50%, rgba(182, 210, 190, 0) 72%);
    border-radius: 50%;
    filter: blur(2px);
  }
  .bm-hero__image {
    position: relative;
    width: 82%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 25px 30px rgba(30, 74, 43, 0.28));
  }
  .bm-hero__badge {
    position: absolute;
    top: 4%;
    right: 2%;
    background: var(--bm-green-dark);
    color: #fff;
    width: 74px;
    height: 74px;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    box-shadow: 0 8px 20px rgba(30, 74, 43, 0.35);
    transform: rotate(-8deg);
    border: 3px solid #fff;
    z-index: 2;
  }
  .bm-hero__badge-num { font-size: 1.15rem; line-height: 1; }
  .bm-hero__badge-label { font-size: 0.65rem; margin-top: 2px; opacity: 0.9; }

  .bm-hero__trust {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #fff;
    border: 1px solid var(--bm-border);
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--bm-text);
    box-shadow: var(--bm-shadow);
  }
  .bm-hero__stars { color: #f5b400; letter-spacing: 2px; font-size: 0.9rem; }

  .bm-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: linear-gradient(180deg, #3a8250 0%, var(--bm-green-dark) 100%);
    color: #fff;
    padding: 1rem 1.75rem;
    border-radius: 999px;
    font-weight: 800;
    font-size: 1.05rem;
    box-shadow: 0 12px 28px rgba(30, 74, 43, 0.28);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    min-height: 56px;
    width: min(360px, 100%);
  }
  .bm-hero__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 32px rgba(30, 74, 43, 0.35);
  }
  .bm-hero__cta-arrow { font-size: 1.15rem; }

  .bm-hero__mini-trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem 1.1rem;
    color: var(--bm-muted);
    font-size: 0.85rem;
    font-weight: 600;
  }

  /* ============ SECTION SHELL ============ */
  .bm-section {
    padding: 2.5rem 1rem;
    max-width: 1100px;
    margin: 0 auto;
    scroll-margin-top: 80px; /* offset for sticky header when scrolling to anchors */
  }
  #bayel-moss-lp #lp-order { scroll-margin-top: 72px; }

  /* Attention flash when user arrives on the order form via a CTA */
  @keyframes bmFormFlash {
    0%   { box-shadow: 0 0 0 0 rgba(180,138,58,0.75), 0 22px 44px -28px rgba(15,30,20,0.28); }
    40%  { box-shadow: 0 0 0 14px rgba(180,138,58,0.15), 0 22px 44px -28px rgba(15,30,20,0.28); }
    100% { box-shadow: 0 0 0 0 rgba(180,138,58,0), 0 22px 44px -28px rgba(15,30,20,0.28); }
  }
  #bayel-moss-lp .bm-form.is-flash {
    animation: bmFormFlash 1.4s ease-out 1;
  }
  @media (prefers-reduced-motion: reduce) {
    #bayel-moss-lp .bm-form.is-flash { animation: none; }
  }
  .bm-section__head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }
  .bm-section__title {
    font-size: clamp(1.5rem, 5vw, 2.15rem);
    font-weight: 900;
    line-height: 1.25;
    color: var(--bm-text);
  }
  .bm-section__sub {
    color: var(--bm-muted);
    font-size: 0.98rem;
    line-height: 1.6;
    max-width: 44ch;
  }
  .bm-section__sub--light { color: rgba(255,255,255,0.82); }
  .bm-section__head--light .bm-section__title { color: #fff; }
  .bm-kicker {
    display: inline-block;
    color: var(--bm-green);
    background: var(--bm-green-soft);
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .bm-kicker--light {
    background: rgba(255,255,255,0.14);
    color: #d9e8dd;
  }

  /* ============ UGC ============ */
  .bm-ugc {
    display: flex;
    gap: 0.9rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0.5rem 1rem 1.25rem;
    margin: 0 -1rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .bm-ugc::-webkit-scrollbar { display: none; }

  .bm-ugc__card {
    flex: 0 0 78%;
    max-width: 300px;
    scroll-snap-align: center;
    background: #fff;
    border-radius: var(--bm-radius);
    overflow: hidden;
    box-shadow: var(--bm-shadow);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--bm-border);
  }
  .bm-ugc__media {
    position: relative;
    aspect-ratio: 9 / 16;
    background: #1e4a2b;
    overflow: hidden;
  }
  .bm-ugc__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background: #1e4a2b;
  }
  .bm-ugc__play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 62px;
    height: 62px;
    border-radius: 50%;
    background: rgba(255,255,255,0.95);
    color: var(--bm-green-dark);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
    transition: transform 0.15s ease, opacity 0.2s ease;
    padding: 0;
  }
  .bm-ugc__play:hover { transform: scale(1.06); }
  .bm-ugc__play svg { margin-right: -3px; }
  .bm-ugc__card.is-playing .bm-ugc__play { opacity: 0; pointer-events: none; }

  .bm-ugc__caption {
    padding: 0.9rem 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-align: center;
  }
  .bm-ugc__caption strong { font-size: 0.98rem; color: var(--bm-text); }
  .bm-ugc__caption span { font-size: 0.78rem; color: var(--bm-muted); }

  /* ============ ORDER (OFFERS + FORM) ============ */
  .bm-order {
    background: linear-gradient(180deg, transparent 0%, rgba(217,232,221,0.4) 100%);
  }
  .bm-order__layout {
    display: grid;
    gap: 1.5rem;
    max-width: 640px;
    margin: 0 auto;
  }

  /* Offers */
  .bm-offers {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .bm-offer {
    position: relative;
    display: block;
    cursor: pointer;
  }
  .bm-offer input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .bm-offer__card {
    background: #fff;
    border: 2px solid var(--bm-border);
    border-radius: var(--bm-radius);
    padding: 1rem 1.1rem;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'head prices' 'blurb blurb';
    gap: 0.4rem 0.6rem;
    align-items: center;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.15s ease;
    box-shadow: var(--bm-shadow);
  }
  .bm-offer input:checked ~ .bm-offer__card {
    border-color: var(--bm-green);
    box-shadow: 0 0 0 4px var(--bm-green-soft), var(--bm-shadow);
  }
  .bm-offer__card:hover { transform: translateY(-1px); }
  .bm-offer__head {
    grid-area: head;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .bm-offer__qty {
    font-weight: 800;

    #bayel-moss-lp *,
    #bayel-moss-lp *::before,
    #bayel-moss-lp *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }

  @media (min-width: 990px) {
    .bm-hero__inner { max-width: 1000px; }
    .bm-hero__title { font-size: 3.4rem; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    const root = document.getElementById('bayel-moss-lp');
    if (!root) return;

    /* -------- OFFERS -> quantity + line properties -------- */
    const offerInputs = root.querySelectorAll('input[name="bm-offer"]');
    const qtyInput = root.querySelector('[data-bm-quantity]');
    const offerProp = root.querySelector('[data-bm-offer-prop]');
    const ctaLabel = root.querySelector('[data-bm-cta-label]');
    const price1 = Number(root.dataset.price1) || 189;

    function applyOffer(input) {
      if (!input) return;
      const qty = Number(input.dataset.qty) || 1;
      const price = Number(input.dataset.price) || price1;
      if (qtyInput) qtyInput.value = qty;
      if (offerProp) offerProp.value = qty + ' units';
      if (ctaLabel) ctaLabel.textContent = 'اطلب الآن · ' + price + ' درهم';
    }

    offerInputs.forEach((inp) => {
      inp.addEventListener('change', () => applyOffer(inp));
    });
    const checked = root.querySelector('input[name="bm-offer"]:checked');
    if (checked) applyOffer(checked);

    /* -------- UGC: click to play/pause -------- */
    const cards = root.querySelectorAll('.bm-ugc__card');
    cards.forEach((card) => {
      const video = card.querySelector('[data-ugc-video]');
      const play = card.querySelector('[data-ugc-play]');
      if (!video || !play) return;
      const start = () => {
        cards.forEach((c) => {
          if (c !== card) {
            const v = c.querySelector('video');
            if (v) { v.pause(); }
            c.classList.remove('is-playing');
          }
        });
        video.muted = false;
        video.play().then(() => card.classList.add('is-playing')).catch(() => {
          video.muted = true;
          video.play();
          card.classList.add('is-playing');
        });
      };
      play.addEventListener('click', start);
      video.addEventListener('play', () => card.classList.add('is-playing'));
      video.addEventListener('pause', () => card.classList.remove('is-playing'));
      video.addEventListener('ended', () => card.classList.remove('is-playing'));
    });

    /* -------- Country prop always AE for this store -------- */
    const countryProp = root.querySelector('[data-bm-country-prop]');
    if (countryProp) countryProp.value = root.dataset.defaultCountry || 'AE';

    /* -------- Smooth-scroll for ALL internal anchor links (header CTA, hero CTA, drawer, final CTA, footer nav) -------- */
    const orderForm = root.querySelector('.bm-form');
    const localHeader = root.querySelector('.bm-header');
    let flashTimer = null;

    const smoothScrollTo = (target, opts) => {
      const headerH = localHeader ? localHeader.getBoundingClientRect().height : 0;
      const extra = (opts && opts.extra) || 8;
      const rect = target.getBoundingClientRect();
      const y = window.scrollY + rect.top - headerH - extra;
      window.scrollTo({ top: Math.max(0, y), behavior: 'smooth' });
    };

    const flashOrderForm = () => {
      if (!orderForm) return;
      orderForm.classList.remove('is-flash');
      // force reflow so animation replays if user re-clicks CTA
      void orderForm.offsetWidth;
      orderForm.classList.add('is-flash');
      if (flashTimer) clearTimeout(flashTimer);
      flashTimer = setTimeout(() => orderForm.classList.remove('is-flash'), 1600);
    };

    root.addEventListener('click', (e) => {
      const a = e.target.closest('a[href^="#"]');
      if (!a) return;
      const href = a.getAttribute('href');
      if (!href || href === '#' || href === '#top') return;
      const target = root.querySelector(href) || document.querySelector(href);
      if (!target) return;
      e.preventDefault();
      smoothScrollTo(target);
      // Close drawer if open
      const drawer = root.querySelector('[data-bm-drawer]');
      const header = root.querySelector('.bm-header');
      if (drawer && !drawer.hasAttribute('hidden')) {
        drawer.setAttribute('hidden', '');
        header && header.classList.remove('is-open');
      }
      // Flash the order form if the anchor targets the order section or the form itself
      if (href === '#lp-order' || (orderForm && target.contains(orderForm)) || target === orderForm) {
        // wait a bit so the flash starts as the form comes into view
        setTimeout(flashOrderForm, 350);
      }
    });

    /* -------- Burger toggle -------- */
    const burger = root.querySelector('[data-bm-burger]');
    const drawer = root.querySelector('[data-bm-drawer]');
    const header = root.querySelector('.bm-header');
    if (burger && drawer && header) {
      burger.addEventListener('click', () => {
        const isOpen = !drawer.hasAttribute('hidden');
        if (isOpen) {
          drawer.setAttribute('hidden', '');
          header.classList.remove('is-open');
        } else {
          drawer.removeAttribute('hidden');
          header.classList.add('is-open');
        }
      });
    }
  })();
{% endjavascript %}


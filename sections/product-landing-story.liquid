{%- comment -%}
  Lead export removed — EasySell COD Form & Upsells now handles the checkout flow.
  EasySell auto-detects form[action="/cart/add"] with a [name="add"] submit button
  and opens its own popup to collect Customer name/phone/city/address, then creates
  a real Shopify order that is pushed to CodNetwork by EasySell's native integration.
  If you want to restore the custom backend/Sheet pipeline, restore the block below
  and re-add the customer fields to the form.
{%- endcomment -%}

{% stylesheet %}
  /* ==========================================================================
     BAYEL MOSS LP — Isolated styles
     All rules scoped under #bayel-moss-lp to prevent global bleed.
     ========================================================================== */

  /* Hide legacy sections that persist in the theme editor state for this template.
     Scoped only to Bayel Moss LP template to avoid affecting other pages. */
  body.template-product-bayel-moss-lp .shopify-section:has(> .product-information),
  body.template-product-bayel-moss-lp .shopify-section:has(> .product-recommendations),
  body.template-product-bayel-moss-lp .shopify-section > .product-information,
  body.template-product-bayel-moss-lp .shopify-section > .product-recommendations {
    display: none !important;
  }

  /* Hide the global Shopify theme header + announcement bar ONLY on the Bayel Moss LP
     so the local .bm-header takes over the full experience. */
  body.template-product-bayel-moss-lp #header-component,
  body.template-product-bayel-moss-lp header.header,
  body.template-product-bayel-moss-lp .shopify-section-header,
  body.template-product-bayel-moss-lp .shopify-section-group-header-group,
  body.template-product-bayel-moss-lp .header-wrapper,
  body.template-product-bayel-moss-lp .announcement-bar,
  body.template-product-bayel-moss-lp .utility-bar {
    display: none !important;
  }

  #bayel-moss-lp {
    --bm-bg: #f5efe4;
    --bm-panel: #ffffff;
    --bm-green-dark: #1e4a2b;
    --bm-green: #2f6b3f;
    --bm-green-soft: #d9e8dd;
    --bm-gold: #b48a3a;
    --bm-text: #1f2b21;
    --bm-muted: #5c6b5e;
    --bm-border: rgba(31, 43, 33, 0.10);
    --bm-shadow: 0 12px 30px rgba(20, 40, 25, 0.08);
    --bm-shadow-lg: 0 20px 50px rgba(20, 40, 25, 0.12);
    --bm-radius: 18px;
    --bm-radius-sm: 12px;
    --bm-radius-lg: 24px;

    background: var(--bm-bg);
    color: var(--bm-text);
    font-family: 'DIN Next LT Arabic', 'Almarai', 'Cairo', 'Tajawal', system-ui, -apple-system, Segoe UI, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    direction: rtl;
    text-align: right;
    overflow-x: clip;
    min-height: 100vh;
    position: relative;
    padding-bottom: env(safe-area-inset-bottom);
  }

  #bayel-moss-lp *,
  #bayel-moss-lp *::before,
  #bayel-moss-lp *::after {
    box-sizing: border-box;
  }

  #bayel-moss-lp img,
  #bayel-moss-lp video {
    max-width: 100%;
    display: block;
  }

  #bayel-moss-lp h1,
  #bayel-moss-lp h2,
  #bayel-moss-lp h3,
  #bayel-moss-lp h4,
  #bayel-moss-lp p,
  #bayel-moss-lp ul,
  #bayel-moss-lp ol {
    margin: 0;
    padding: 0;
  }

  #bayel-moss-lp ul,
  #bayel-moss-lp ol {
    list-style: none;
  }

  #bayel-moss-lp a {
    color: inherit;
    text-decoration: none;
  }

  /* ============ RESET BUTTON TEXT to guarantee white on green CTAs
     (overrides any inherited base.css / dawn theme button styles) ============ */
  #bayel-moss-lp .bm-hero__cta,
  #bayel-moss-lp .bm-final__cta,
  #bayel-moss-lp .bm-header__cta,
  #bayel-moss-lp .bm-header__drawer-cta {
    color: #ffffff !important;
    text-transform: none !important;
    letter-spacing: 0.005em;
    font-family: inherit;
    text-shadow: 0 1px 2px rgba(15, 30, 20, 0.28);
    -webkit-text-fill-color: #ffffff;
  }

  /* ============ LOCAL HEADER ============ */
  .bm-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: #f5efe4;
    border-bottom: 1px solid var(--bm-border);
    box-shadow: 0 1px 0 rgba(20,40,25,0.02);
  }
  .bm-header__inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0.65rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }
  .bm-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 900;
    font-size: 1.1rem;
    color: var(--bm-green-dark);
    letter-spacing: -0.01em;
  }
  .bm-header__brand-mark {
    color: var(--bm-gold);
    font-size: 1.15rem;
    line-height: 1;
    transform: translateY(-1px);
  }
  .bm-header__nav {
    display: none;
    align-items: center;
    gap: 1.4rem;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--bm-text);
  }
  .bm-header__nav a {
    position: relative;
    color: var(--bm-text);
    padding: 0.3rem 0;
    transition: color 0.15s ease;
  }
  .bm-header__nav a::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 2px;
    background: var(--bm-green);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.2s ease;
  }
  .bm-header__nav a:hover { color: var(--bm-green-dark); }
  .bm-header__nav a:hover::after { transform: scaleX(1); }

  .bm-header__cta {
    background: var(--bm-green);
    color: #ffffff;
    padding: 0.62rem 1.2rem;
    border-radius: 999px;
    font-weight: 800;
    font-size: 0.9rem;
    transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
    box-shadow: 0 6px 14px rgba(30, 74, 43, 0.22);
    white-space: nowrap;
  }
  .bm-header__cta:hover {
    background: var(--bm-green-dark);
    transform: translateY(-1px);
    box-shadow: 0 10px 18px rgba(30, 74, 43, 0.3);
  }

  .bm-header__burger {
    display: none;
    background: transparent;
    border: 1px solid var(--bm-border);
    border-radius: 10px;
    width: 42px;
    height: 42px;
    padding: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
  }
  .bm-header__burger span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--bm-green-dark);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .bm-header.is-open .bm-header__burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .bm-header.is-open .bm-header__burger span:nth-child(2) { opacity: 0; }
  .bm-header.is-open .bm-header__burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .bm-header__drawer {
    display: none;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.5rem 1rem 1rem;
    border-top: 1px solid var(--bm-border);
    background: #f5efe4;
  }
  .bm-header__drawer:not([hidden]) { display: flex; }
  .bm-header__drawer a {
    padding: 0.85rem 0.75rem;
    border-radius: 12px;
    font-weight: 700;
    font-size: 0.98rem;
    color: var(--bm-text);
    background: rgba(255,255,255,0.55);
  }
  .bm-header__drawer-cta {
    background: var(--bm-green) !important;
    color: #ffffff !important;
    text-align: center;
    margin-top: 0.35rem;
  }

  /* ============ ANNOUNCE MARQUEE ============ */
  .bm-announce {
    background: var(--bm-green-dark);
    color: #fff;
    overflow: hidden;
    font-size: 0.82rem;
    font-weight: 600;
  }
  .bm-announce__track {
    display: flex;
    gap: 2.5rem;
    padding: 0.5rem 0;
    white-space: nowrap;
    animation: bm-marquee 32s linear infinite;
    width: max-content;
  }
  .bm-announce__track span { flex: none; }
  @keyframes bm-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(50%); }
  }

  /* ============ HERO ============ */
  .bm-hero {
    padding: 1.75rem 1rem 2rem;
  }
  .bm-hero__inner {
    max-width: 640px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
  }
  .bm-hero__eyebrow {
    display: inline-block;
    color: var(--bm-green);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    text-transform: none;
    padding: 0.35rem 0.85rem;
    background: var(--bm-green-soft);
    border-radius: 999px;
  }
  .bm-hero__title {
    font-size: clamp(2rem, 7.5vw, 3.1rem);
    font-weight: 900;
    line-height: 1.15;
    color: var(--bm-text);
    letter-spacing: -0.01em;
  }
  .bm-hero__title-em {
    color: var(--bm-green-dark);
  }
  .bm-hero__lead {
    color: var(--bm-muted);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 34ch;
  }
  .bm-hero__media {
    position: relative;
    width: min(320px, 78%);
    margin: 0.5rem auto;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .bm-hero__orb {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 45%, #cfe4d4 0%, #b6d2be 50%, rgba(182, 210, 190, 0) 72%);
    border-radius: 50%;
    filter: blur(2px);
  }
  .bm-hero__image {
    position: relative;
    width: 95%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 25px 30px rgba(30, 74, 43, 0.28));
  }

  .bm-hero__trust {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #fff;
    border: 1px solid var(--bm-border);
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--bm-text);
    box-shadow: var(--bm-shadow);
  }
  .bm-hero__stars { color: #f5b400; letter-spacing: 2px; font-size: 0.9rem; }

  .bm-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: linear-gradient(180deg, #3a8250 0%, var(--bm-green-dark) 100%);
    color: #fff;
    padding: 1rem 1.75rem;
    border-radius: 999px;
    font-weight: 800;
    font-size: 1.05rem;
    box-shadow: 0 12px 28px rgba(30, 74, 43, 0.28);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    min-height: 56px;
    width: min(360px, 100%);
  }
  .bm-hero__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 32px rgba(30, 74, 43, 0.35);
  }
  .bm-hero__cta-arrow { font-size: 1.15rem; }

  .bm-hero__mini-trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem 1.1rem;
    color: var(--bm-muted);
    font-size: 0.85rem;
    font-weight: 600;
  }

  /* ============ SECTION SHELL ============ */
  .bm-section {
    padding: 2.5rem 1rem;
    max-width: 1100px;
    margin: 0 auto;
    scroll-margin-top: 80px; /* offset for sticky header when scrolling to anchors */
  }
  #bayel-moss-lp #lp-order { scroll-margin-top: 72px; }

  /* Attention flash when user arrives on the order form via a CTA */
  @keyframes bmFormFlash {
    0%   { box-shadow: 0 0 0 0 rgba(180,138,58,0.75), 0 22px 44px -28px rgba(15,30,20,0.28); }
    40%  { box-shadow: 0 0 0 14px rgba(180,138,58,0.15), 0 22px 44px -28px rgba(15,30,20,0.28); }
    100% { box-shadow: 0 0 0 0 rgba(180,138,58,0), 0 22px 44px -28px rgba(15,30,20,0.28); }
  }
  #bayel-moss-lp .bm-order.is-flash .bm-order__intro {
    animation: bmFormFlash 1.4s ease-out 1;
    border-radius: 20px;
  }
  @media (prefers-reduced-motion: reduce) {
    #bayel-moss-lp .bm-order.is-flash .bm-order__intro { animation: none; }
  }
  .bm-section__head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }
  .bm-section__title {
    font-size: clamp(1.5rem, 5vw, 2.15rem);
    font-weight: 900;
    line-height: 1.25;
    color: var(--bm-text);
  }
  .bm-section__sub {
    color: var(--bm-muted);
    font-size: 0.98rem;
    line-height: 1.6;
    max-width: 44ch;
  }
  .bm-section__sub--light { color: rgba(255,255,255,0.82); }
  .bm-section__head--light .bm-section__title { color: #fff; }
  .bm-kicker {
    display: inline-block;
    color: var(--bm-green);
    background: var(--bm-green-soft);
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .bm-kicker--light {
    background: rgba(255,255,255,0.14);
    color: #d9e8dd;
  }

  /* ============ UGC ============ */
  .bm-ugc {
    display: flex;
    gap: 0.9rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0.5rem 1rem 1.25rem;
    margin: 0 -1rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .bm-ugc::-webkit-scrollbar { display: none; }

  .bm-ugc__card {
    flex: 0 0 78%;
    max-width: 300px;
    scroll-snap-align: center;
    background: #fff;
    border-radius: var(--bm-radius);
    overflow: hidden;
    box-shadow: var(--bm-shadow);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--bm-border);
  }
  .bm-ugc__media {
    position: relative;
    aspect-ratio: 9 / 16;
    background: #1e4a2b;
    overflow: hidden;
  }
  .bm-ugc__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background: #1e4a2b;
  }
  .bm-ugc__play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 62px;
    height: 62px;
    border-radius: 50%;
    background: rgba(255,255,255,0.95);
    color: var(--bm-green-dark);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
    transition: transform 0.15s ease, opacity 0.2s ease;
    padding: 0;
  }
  .bm-ugc__play:hover { transform: scale(1.06); }
  .bm-ugc__play svg { margin-right: -3px; }
  .bm-ugc__card.is-playing .bm-ugc__play { opacity: 0; pointer-events: none; }

  .bm-ugc__caption {
    padding: 0.9rem 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-align: center;
  }
  .bm-ugc__caption strong { font-size: 0.98rem; color: var(--bm-text); }
  .bm-ugc__caption span { font-size: 0.78rem; color: var(--bm-muted); }

  /* ============ ORDER SECTION (EasySell injects its own form + offers below the intro) ============ */
  .bm-order {
    background: linear-gradient(180deg, transparent 0%, rgba(217,232,221,0.4) 100%);
    padding-bottom: 1.5rem;
  }
  .bm-order__intro {
    max-width: 640px;
    margin: 0 auto 1.25rem;
    background: #ffffff;
    border: 1px solid var(--bm-border);
    border-radius: 20px;
    padding: 1.5rem 1.25rem 1.25rem;
    box-shadow: 0 22px 44px -28px rgba(15,30,20,0.18);
  }
  .bm-order__benefits {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bm-order__benefits li {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 0.75rem 0.85rem;
    background: #f6f2e6;
    border: 1px solid #e6ddc4;
    border-radius: 14px;
  }
  .bm-order__benefits li strong {
    display: block;
    font-size: 0.98rem;
    font-weight: 800;
    color: var(--bm-green-dark);
    margin-bottom: 0.15rem;
  }
  .bm-order__benefits li span:not(.bm-order__benefit-ic) {
    display: block;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--bm-muted);
  }
  .bm-order__benefit-ic {
    display: inline-flex;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    background: #fff;
    border-radius: 50%;
    font-size: 1.15rem;
    box-shadow: 0 2px 6px rgba(30, 74, 43, 0.12);
    flex: none;
  }
  .bm-order__pointer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 0.6rem 0.9rem;
    background: linear-gradient(135deg, var(--bm-green-dark) 0%, var(--bm-green) 100%);
    color: #fff;
    border-radius: 12px;
    font-size: 0.92rem;
    font-weight: 700;
  }
  .bm-order__pointer-arrow {
    display: inline-flex;
    animation: bmPointerBounce 1.2s ease-in-out infinite;
    font-size: 1.15rem;
  }
  @keyframes bmPointerBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .bm-order__pointer-arrow { animation: none; }
  }

  /* Anchor form is invisible — EasySell reads it and hides the button itself */
  #bayel-moss-lp .bm-form--anchor {
    position: absolute;
    width: 0;
    height: 0;
    padding: 0;
    margin: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    pointer-events: none;
  }

  /* Give EasySell's injected form some breathing room and consistent centering */
  #bayel-moss-lp .easysell-form-container,
  #bayel-moss-lp [class*="easysell-form"],
  #bayel-moss-lp .es-form,
  #bayel-moss-lp [id*="easysell-form"] {
    max-width: 640px;
    margin-inline: auto;
  }

  /* ============ PROBLEM ============ */
  .bm-problem__grid {
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.15rem;
    align-items: center;
  }
  .bm-problem__figure {
    margin: 0;
    position: relative;
    border-radius: var(--bm-radius);
    overflow: hidden;
    box-shadow: var(--bm-shadow);
    aspect-ratio: 4 / 5;
    max-width: 340px;
    margin-inline: auto;
    background: #d9d1c2;
  }
  .bm-problem__figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .bm-problem__figure figcaption {
    position: absolute;
    top: 0.75rem;
    inset-inline-start: 0.75rem;
    background: rgba(30, 43, 33, 0.78);
    color: #fff;
    padding: 0.28rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    backdrop-filter: blur(2px);
  }
  .bm-problem__list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .bm-problem__list li {
    background: #fff;
    padding: 0.9rem 1rem;
    border-radius: var(--bm-radius-sm);
    border: 1px solid var(--bm-border);
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: 0.95rem;
    color: var(--bm-text);
    box-shadow: 0 2px 6px rgba(20,40,25,0.04);
  }
  .bm-x {
    display: inline-flex;
    width: 24px;
    height: 24px;
    align-items: center;
    justify-content: center;
    background: rgba(200,68,43,0.1);
    color: #c8442b;
    border-radius: 50%;
    font-weight: 800;
    font-size: 0.8rem;
    flex: none;
    margin-top: 2px;
  }
  .bm-problem__solution {
    max-width: 640px;
    margin: 1.5rem auto 0;
    background: var(--bm-green-soft);
    color: var(--bm-green-dark);
    padding: 1.1rem 1.15rem;
    border-radius: var(--bm-radius);
    line-height: 1.7;
    font-size: 0.98rem;
    border-right: 4px solid var(--bm-green);
  }
  .bm-problem__solution strong { color: var(--bm-green-dark); display: block; margin-bottom: 0.3rem; font-size: 1.05rem; }

  /* ============ STEPS ============ */
  .bm-steps__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    max-width: 900px;
    margin: 0 auto;
  }
  .bm-step {
    background: #fff;
    padding: 1.25rem 1rem 1.1rem;
    border-radius: var(--bm-radius);
    text-align: center;
    box-shadow: var(--bm-shadow);
    border: 1px solid var(--bm-border);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    position: relative;
  }
  .bm-step__num {
    display: inline-flex;
    width: 42px;
    height: 42px;
    align-items: center;
    justify-content: center;
    background: var(--bm-green-dark);
    color: #fff;
    border-radius: 50%;
    font-weight: 900;
    font-size: 1.05rem;
    box-shadow: 0 4px 12px rgba(30,74,43,0.25);
  }
  .bm-step h3 { font-size: 1rem; font-weight: 800; color: var(--bm-text); }
  .bm-step p { font-size: 0.85rem; color: var(--bm-muted); line-height: 1.55; }

  /* ============ INGREDIENTS ============ */
  .bm-ingredients {
    background: var(--bm-green-dark);
    color: #fff;
    max-width: none;
    padding: 2.5rem 1rem;
    margin: 2rem 0 0;
    border-radius: 0;
  }
  .bm-ingredients .bm-section__head { max-width: 640px; margin-left: auto; margin-right: auto; }
  .bm-ingredients__chips {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.75rem;
    max-width: 880px;
    margin: 1.4rem auto 0;
    list-style: none;
  }
  .bm-ingredients__chips li {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.14);
    padding: 0.85rem 1rem;
    border-radius: 14px;
    display: grid;
    grid-template-columns: 40px 1fr;
    grid-template-rows: auto auto;
    column-gap: 0.75rem;
    row-gap: 0.15rem;
    align-items: start;
    text-align: right;
  }
  .bm-ing__ic {
    grid-row: 1 / span 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: rgba(255,255,255,0.10);
    border-radius: 10px;
    font-size: 1.15rem;
  }
  .bm-ingredients__chips strong {
    font-size: 0.98rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.3;
  }
  .bm-ingredients__chips em {
    font-style: normal;
    font-size: 0.82rem;
    color: rgba(255,255,255,0.72);
    line-height: 1.45;
  }

  /* ============ TIMELINE ============ */
  .bm-timeline__list {
    list-style: none;
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem;
    padding: 0;
    counter-reset: bmtl;
  }
  .bm-timeline__item {
    background: #fff;
    padding: 1.15rem 1.15rem 1rem;
    border-radius: var(--bm-radius);
    box-shadow: var(--bm-shadow);
    border: 1px solid var(--bm-border);
    position: relative;
    padding-inline-start: 1.15rem;
  }
  .bm-timeline__badge {
    display: inline-block;
    background: linear-gradient(90deg, var(--bm-green-dark), var(--bm-green));
    color: #fff;
    font-weight: 700;
    font-size: 0.82rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    margin-bottom: 0.6rem;
    letter-spacing: 0.02em;
  }
  .bm-timeline__item h3 {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--bm-green-dark);
    margin-bottom: 0.4rem;
    line-height: 1.35;
  }
  .bm-timeline__item p {
    font-size: 0.95rem;
    color: var(--bm-muted);
    line-height: 1.65;
  }

  /* ============ COMPARISON TABLE ============ */
  .bm-compare__wrap {
    max-width: 960px;
    margin: 0 auto;
    overflow-x: auto;
    border-radius: var(--bm-radius);
    box-shadow: var(--bm-shadow);
    background: #fff;
    border: 1px solid var(--bm-border);
  }
  .bm-compare__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    min-width: 520px;
  }
  .bm-compare__table th,
  .bm-compare__table td {
    padding: 0.85rem 0.7rem;
    text-align: center;
    vertical-align: middle;
    border-bottom: 1px solid var(--bm-border);
  }
  .bm-compare__table thead th {
    background: #faf6ee;
    font-weight: 800;
    color: var(--bm-green-dark);
    font-size: 0.88rem;
    border-bottom: 2px solid var(--bm-border);
  }
  .bm-compare__col--us {
    background: linear-gradient(180deg, var(--bm-green-dark), var(--bm-green)) !important;
    color: #fff !important;
    position: relative;
  }
  .bm-compare__logo {
    display: inline-block;
    color: var(--bm-gold);
    margin-inline-end: 0.3rem;
    font-size: 1rem;
  }
  .bm-compare__table tbody th {
    text-align: right;
    background: #faf6ee;
    font-weight: 700;
    color: var(--bm-text);
    font-size: 0.88rem;
    white-space: nowrap;
  }
  .bm-compare__cell--us {
    background: rgba(47, 107, 63, 0.06);
    font-weight: 600;
    color: var(--bm-green-dark);
  }
  .bm-compare__table tbody tr:last-child th,
  .bm-compare__table tbody tr:last-child td { border-bottom: none; }
  .bm-tick {
    display: inline-block;
    color: var(--bm-green);
    font-weight: 900;
    margin-inline-end: 0.2rem;
  }
  .bm-compare__cell--us .bm-tick { color: #b6e3a4; }

  /* ============ STICKY MOBILE CTA ============ */
  .bm-sticky-cta {
    position: fixed;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 0.5rem);
    inset-inline: 0.6rem;
    z-index: 60;
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    background: linear-gradient(90deg, var(--bm-green-dark), var(--bm-green));
    color: #fff !important;
    padding: 0.85rem 1.1rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 800;
    font-size: 0.98rem;
    box-shadow: 0 12px 32px rgba(20,40,25,0.28), 0 0 0 2px rgba(180, 138, 58, 0.35);
    text-shadow: 0 1px 2px rgba(15, 30, 20, 0.28);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .bm-sticky-cta:active { transform: translateY(1px) scale(0.99); }
  .bm-sticky-cta__label { flex: 1; text-align: right; line-height: 1.2; }
  .bm-sticky-cta__price {
    background: rgba(255,255,255,0.16);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .bm-sticky-cta__arrow { font-size: 1.15rem; }

  /* ============ REVIEWS ============ */
  .bm-reviews__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem;
    max-width: 900px;
    margin: 0 auto;
  }
  .bm-review {
    background: #fff;
    padding: 1.15rem 1.15rem 1rem;
    border-radius: var(--bm-radius);
    box-shadow: var(--bm-shadow);
    border: 1px solid var(--bm-border);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .bm-review__stars { color: #f5b400; letter-spacing: 2px; font-size: 0.95rem; }
  .bm-review p { font-size: 0.95rem; color: var(--bm-text); line-height: 1.7; }
  .bm-review footer {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--bm-border);
  }
  .bm-review__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--bm-green-soft);
    flex: none;
    box-shadow: 0 3px 8px rgba(20,40,25,0.08);
  }
  .bm-review__meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    flex: 1;
    min-width: 0;
  }
  .bm-review footer strong { font-weight: 800; font-size: 0.92rem; color: var(--bm-text); }
  .bm-review footer span { font-size: 0.76rem; color: var(--bm-muted); }
  .bm-review__verified {
    width: 24px;
    height: 24px;
    background: var(--bm-green);
    color: #fff;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 900;
    flex: none;
  }

  /* ============ FAQ ============ */
  .bm-faq__list {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .bm-faq__item {
    background: #fff;
    border-radius: var(--bm-radius-sm);
    border: 1px solid var(--bm-border);
    overflow: hidden;
    box-shadow: 0 2px 6px rgba(20,40,25,0.04);
  }
  .bm-faq__item summary {
    padding: 1rem 1.1rem;
    font-weight: 800;
    font-size: 0.98rem;
    color: var(--bm-text);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    list-style: none;
    min-height: 56px;
  }
  .bm-faq__item summary::-webkit-details-marker { display: none; }
  .bm-faq__item summary::after {
    content: '+';
    color: var(--bm-green);
    font-weight: 800;
    font-size: 1.3rem;
    line-height: 1;
    transition: transform 0.2s ease;
  }
  .bm-faq__item[open] summary::after {
    transform: rotate(45deg);
  }
  .bm-faq__item p {
    padding: 0 1.1rem 1rem;
    font-size: 0.9rem;
    color: var(--bm-muted);
    line-height: 1.7;
  }

  /* ============ FINAL CTA ============ */
  .bm-final {
    text-align: center;
    padding: 2.5rem 1rem 3rem;
    max-width: 720px;
    margin: 0 auto;
  }
  .bm-final h2 {
    font-size: clamp(1.5rem, 5vw, 2.15rem);
    font-weight: 900;
    color: var(--bm-text);
    margin-bottom: 0.5rem;
  }
  .bm-final p {
    color: var(--bm-muted);
    font-size: 0.98rem;
    margin-bottom: 1.2rem;
  }
  .bm-final__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, #3a8250 0%, var(--bm-green-dark) 100%);
    color: #fff;
    padding: 1rem 1.75rem;
    border-radius: 999px;
    font-weight: 900;
    font-size: 1.02rem;
    box-shadow: 0 12px 28px rgba(30, 74, 43, 0.28);
    transition: transform 0.15s ease;
    min-height: 56px;
  }
  .bm-final__cta:hover { transform: translateY(-2px); }

  /* ============ FLOATING WHATSAPP ============ */
  .bm-wa {
    position: fixed;
    bottom: calc(1rem + env(safe-area-inset-bottom));
    left: 1rem;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 12px 24px rgba(37, 211, 102, 0.35);
    z-index: 50;
    transition: transform 0.15s ease;
  }
  .bm-wa:hover { transform: scale(1.06); }

  /* Show sticky CTA on mobile only, and lift WhatsApp so it doesn't overlap */
  @media (max-width: 749px) {
    .bm-sticky-cta { display: flex; }
    .bm-wa { bottom: calc(env(safe-area-inset-bottom, 0px) + 4.5rem); }
    /* Hide sticky CTA when EasySell form area is on-screen (avoid double-CTA) */
    body.bm-order-in-view .bm-sticky-cta { display: none; }
    .bm-hero__image { width: 98%; }
  }

  /* ============ DESKTOP ============ */
  @media (min-width: 750px) {
    .bm-header__nav { display: inline-flex; }
    .bm-header__burger { display: none !important; }
    .bm-header__drawer { display: none !important; }

    .bm-hero { padding: 3rem 1rem 3.5rem; }
    .bm-hero__inner { max-width: 900px; }
    .bm-hero__media { width: min(420px, 65%); }

    .bm-ugc {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      overflow: visible;
      padding: 0.5rem 0 1rem;
      margin: 0;
      gap: 1.1rem;
    }
    .bm-ugc__card { flex: 1; max-width: none; }

    .bm-problem__grid {
      grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
      gap: 2rem;
    }
    .bm-problem__figure { max-width: none; }

    .bm-steps__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .bm-reviews__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .bm-timeline__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .bm-section { padding: 3rem 1rem; }
  }

  /* Mobile only: show burger, hide inline CTA in header on very tight widths */
  @media (max-width: 749px) {
    .bm-header__burger { display: inline-flex; }
    .bm-header__cta {
      padding: 0.55rem 0.95rem;
      font-size: 0.82rem;
    }
  }
  @media (max-width: 380px) {
    .bm-header__cta { display: none; }
  }

  /* Perf: defer painting of below-fold blocks on capable browsers */
  @supports (content-visibility: auto) {
    .bm-ingredients,
    .bm-reviews,
    .bm-faq,
    .bm-final {
      content-visibility: auto;
      contain-intrinsic-size: 1px 600px;
    }
  }

  /* Respect users who prefer reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .bm-announce__track { animation: none; }
    #bayel-moss-lp *,
    #bayel-moss-lp *::before,
    #bayel-moss-lp *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }

  @media (min-width: 990px) {
    .bm-hero__inner { max-width: 1000px; }
    .bm-hero__title { font-size: 3.4rem; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    const root = document.getElementById('bayel-moss-lp');
    if (!root) return;

    /* -------- UGC: click to play/pause -------- */
    const cards = root.querySelectorAll('.bm-ugc__card');
    cards.forEach((card) => {
      const video = card.querySelector('[data-ugc-video]');
      const play = card.querySelector('[data-ugc-play]');
      if (!video || !play) return;
      const start = () => {
        cards.forEach((c) => {
          if (c !== card) {
            const v = c.querySelector('video');
            if (v) { v.pause(); }
            c.classList.remove('is-playing');
          }
        });
        video.muted = false;
        video.play().then(() => card.classList.add('is-playing')).catch(() => {
          video.muted = true;
          video.play();
          card.classList.add('is-playing');
        });
      };
      play.addEventListener('click', start);
      video.addEventListener('play', () => card.classList.add('is-playing'));
      video.addEventListener('pause', () => card.classList.remove('is-playing'));
      video.addEventListener('ended', () => card.classList.remove('is-playing'));
    });

    /* -------- Smooth-scroll for ALL internal anchor links (header CTA, hero CTA, drawer, final CTA, footer nav) -------- */
    const orderForm = root.querySelector('.bm-order');
    const localHeader = root.querySelector('.bm-header');
    let flashTimer = null;

    const smoothScrollTo = (target, opts) => {
      const headerH = localHeader ? localHeader.getBoundingClientRect().height : 0;
      const extra = (opts && opts.extra) || 8;
      const rect = target.getBoundingClientRect();
      const y = window.scrollY + rect.top - headerH - extra;
      window.scrollTo({ top: Math.max(0, y), behavior: 'smooth' });
    };

    const flashOrderForm = () => {
      if (!orderForm) return;
      orderForm.classList.remove('is-flash');
      // force reflow so animation replays if user re-clicks CTA
      void orderForm.offsetWidth;
      orderForm.classList.add('is-flash');
      if (flashTimer) clearTimeout(flashTimer);
      flashTimer = setTimeout(() => orderForm.classList.remove('is-flash'), 1600);
    };

    root.addEventListener('click', (e) => {
      const a = e.target.closest('a[href^="#"]');
      if (!a) return;
      const href = a.getAttribute('href');
      if (!href || href === '#' || href === '#top') return;
      const target = root.querySelector(href) || document.querySelector(href);
      if (!target) return;
      e.preventDefault();
      smoothScrollTo(target);
      // Close drawer if open
      const drawer = root.querySelector('[data-bm-drawer]');
      const header = root.querySelector('.bm-header');
      if (drawer && !drawer.hasAttribute('hidden')) {
        drawer.setAttribute('hidden', '');
        header && header.classList.remove('is-open');
      }
      // Flash the order form if the anchor targets the order section or the form itself
      if (href === '#lp-order' || (orderForm && target.contains(orderForm)) || target === orderForm) {
        // wait a bit so the flash starts as the form comes into view
        setTimeout(flashOrderForm, 350);
      }
    });

    /* -------- Same handler for footer links (footer is outside #bayel-moss-lp root) -------- */
    const footerRoot = document.getElementById('bm-footer');
    if (footerRoot) {
      footerRoot.addEventListener('click', (e) => {
        const a = e.target.closest('a[href^="#"]');
        if (!a) return;
        const href = a.getAttribute('href');
        if (!href || href === '#' || href === '#top') return;
        const target = root.querySelector(href) || document.querySelector(href);
        if (!target) return;
        e.preventDefault();
        smoothScrollTo(target);
        if (href === '#lp-order' || (orderForm && target.contains(orderForm)) || target === orderForm) {
          setTimeout(flashOrderForm, 350);
        }
      });
    }

    /* -------- Burger toggle -------- */
    const burger = root.querySelector('[data-bm-burger]');
    const drawer = root.querySelector('[data-bm-drawer]');
    const header = root.querySelector('.bm-header');
    if (burger && drawer && header) {
      burger.addEventListener('click', () => {
        const isOpen = !drawer.hasAttribute('hidden');
        if (isOpen) {
          drawer.setAttribute('hidden', '');
          header.classList.remove('is-open');
        } else {
          drawer.removeAttribute('hidden');
          header.classList.add('is-open');
        }
      });
    }

    /* -------- Sticky mobile CTA: hide when Order section is on-screen -------- */
    if (orderForm && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          document.body.classList.toggle('bm-order-in-view', entry.isIntersecting);
        });
      }, { threshold: 0.15 });
      io.observe(orderForm);
    }
  })();
{% endjavascript %}


{%- comment -%}
  Bloom UAE — isolated Arabic COD product landing page.
  Order flow is now 100% native Shopify: the inline form below collects buyer
  details as line-item properties + cart attributes, then redirects straight to
  /checkout where the customer picks "Cash on Delivery". Orders flow natively
  to the connected Google Sheet + COD Network via Shopify order webhooks.
  EasySell is no longer required and can be uninstalled from the app admin.
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign variant_id = current_variant.id
  assign v1 = section.settings.offer_1_variant_id | default: variant_id
  assign v2 = section.settings.offer_2_variant_id | default: blank
  assign v3 = section.settings.offer_3_variant_id | default: blank
  assign v6 = section.settings.offer_6_variant_id | default: blank
  assign checkout_mode = section.settings.checkout_mode | default: 'native'
-%}

{% style %}
  /* Global suppression on Bloom UAE template */
  body.template-product-bloom-uae .shopify-section:has(> .product-information),
  body.template-product-bloom-uae .shopify-section:has(> .product-recommendations),
  body.template-product-bloom-uae .shopify-section > .product-information,
  body.template-product-bloom-uae .shopify-section > .product-recommendations,
  body.template-product-bloom-uae #header-component,
  body.template-product-bloom-uae header.header,
  body.template-product-bloom-uae .shopify-section-header,
  body.template-product-bloom-uae .shopify-section-group-header-group,
  body.template-product-bloom-uae .header-wrapper,
  body.template-product-bloom-uae .announcement-bar,
  body.template-product-bloom-uae .utility-bar { display: none !important; }

  /* Palette extracted from Bloom Collagen Coffee packaging */
  #bloom-uae-lp {
    --bl-page: #fbf4ea;
    --bl-page-2: #f4e4cc;
    --bl-panel: #ffffff;
    --bl-espresso: #3a1e11;
    --bl-espresso-2: #4d2a1a;
    --bl-brown: #6d3b21;
    --bl-copper: #b47443;
    --bl-copper-2: #d19b5c;
    --bl-gold: #dfa864;
    --bl-cream: #f0d5b3;
    --bl-ink: #1c0e08;
    --bl-muted: #6e5849;
    --bl-line: rgba(58, 30, 17, .12);
    --bl-shadow-sm: 0 4px 12px rgba(58, 30, 17, .06);
    --bl-shadow: 0 14px 34px rgba(58, 30, 17, .12);
    --bl-shadow-lg: 0 22px 46px rgba(58, 30, 17, .18);
    background: var(--bl-page);
    color: var(--bl-ink);
    direction: rtl;
    font-family: 'DIN Next LT Arabic', 'Almarai', 'Cairo', 'Tajawal', system-ui, -apple-system, sans-serif;
    line-height: 1.6;
    overflow-x: clip;
    padding-bottom: calc(80px + env(safe-area-inset-bottom));
  }
  #bloom-uae-lp *, #bloom-uae-lp *::before, #bloom-uae-lp *::after { box-sizing: border-box; }
  #bloom-uae-lp img { display: block; max-width: 100%; height: auto; }
  #bloom-uae-lp h1, #bloom-uae-lp h2, #bloom-uae-lp h3, #bloom-uae-lp h4,
  #bloom-uae-lp p, #bloom-uae-lp ul, #bloom-uae-lp ol { margin: 0; padding: 0; }
  #bloom-uae-lp ul, #bloom-uae-lp ol { list-style: none; }
  #bloom-uae-lp a { color: inherit; text-decoration: none; }
  .bl-wrap { width: min(100% - 28px, 780px); margin-inline: auto; }

  .bl-eyebrow { display: inline-block; padding: .28rem .72rem; border-radius: 999px; background: rgba(180, 116, 67, .12); color: var(--bl-copper); font-size: .74rem; font-weight: 900; letter-spacing: .05em; text-transform: uppercase; }
  .bl-heading { color: var(--bl-espresso); font-size: clamp(1.55rem, 6.4vw, 2.35rem); line-height: 1.18; letter-spacing: -.03em; font-weight: 900; }
  .bl-heading em { color: var(--bl-copper); font-style: normal; }
  .bl-copy { color: var(--bl-muted); font-size: 1rem; font-weight: 600; margin-top: .55rem !important; }

  /* Top offer bar */
  .bl-topbar { background: linear-gradient(90deg, var(--bl-espresso), var(--bl-brown)); color: #fbe6c8; font-size: .84rem; font-weight: 800; }
  .bl-topbar__inner { min-height: 42px; display: flex; align-items: center; justify-content: center; gap: .55rem; text-align: center; padding: .35rem 1rem; }

  /* Hero */
  .bl-hero { position: relative; padding: 18px 0 10px; background:
    radial-gradient(120% 78% at 50% 0%, #f5e1c4 0%, transparent 55%),
    radial-gradient(80% 60% at 100% 100%, rgba(180, 116, 67, .18), transparent 70%),
    var(--bl-page); }
  .bl-hero__head { text-align: center; }
  .bl-title { margin-top: .7rem !important; color: var(--bl-espresso); font-size: clamp(2rem, 8.4vw, 3.3rem); line-height: 1.08; letter-spacing: -.045em; font-weight: 900; }
  .bl-title span { color: var(--bl-copper); }
  .bl-lead { margin-top: .95rem !important; color: var(--bl-muted); font-size: clamp(1rem, 4.2vw, 1.12rem); font-weight: 600; }
  .bl-hero { padding: 12px 0 10px; }
  .bl-hero > .bl-wrap { width: min(100% - 12px, 780px); }
  .bl-hero__media { position: relative; margin: .6rem auto .7rem; max-width: 100%; }
  .bl-hero__media::before { content:""; position:absolute; inset:-24px -18px; background: radial-gradient(60% 55% at 50% 42%, rgba(223,168,100,.28), rgba(223,168,100,0) 70%); filter: blur(6px); z-index: 0; pointer-events:none; }
  .bl-hero__frame { position: relative; padding: 3px; border-radius: 26px; background: linear-gradient(155deg, #f4d9ab 0%, #dfa864 22%, #b47443 48%, #6d3b21 78%, #3a1e11 100%); box-shadow: 0 30px 60px -18px rgba(58, 30, 17, .42), 0 12px 26px -10px rgba(180, 116, 67, .35); aspect-ratio: 1086 / 1448; overflow: hidden; z-index: 1; }
  .bl-hero__frame::before { content:""; position:absolute; inset:3px; border-radius: 23px; background: radial-gradient(120% 90% at 50% 0%, rgba(255,236,205,.45), rgba(255,236,205,0) 55%), #1a0d06; z-index: 0; }
  .bl-hero__frame::after { content:""; position:absolute; inset:3px; border-radius: 23px; border: 1px solid rgba(255, 236, 205, .35); box-shadow: inset 0 0 0 1px rgba(58,30,17,.35); pointer-events: none; z-index: 3; }
  #bloom-uae-lp .bl-hero__frame picture { position: relative; z-index: 2; display: block; width: 100%; height: 100%; border-radius: 23px; overflow: hidden; background: transparent; }
  #bloom-uae-lp .bl-hero__frame img { position: relative; z-index: 2; display: block; width: 100%; height: 100%; object-fit: contain; object-position: center; aspect-ratio: auto; background: transparent; }
  .bl-hero__badges { position: absolute; left: 50%; bottom: -18px; transform: translateX(-50%); display: flex; gap: .5rem; z-index: 2; flex-wrap: wrap; justify-content: center; padding-inline: 8px; }
  .bl-hero__badge { padding: .38rem .78rem; border-radius: 999px; background: var(--bl-panel); color: var(--bl-espresso); font-size: .78rem; font-weight: 900; box-shadow: var(--bl-shadow-sm); border: 1px solid var(--bl-line); }
  .bl-hero__trust { margin-top: 2rem; display: flex; justify-content: center; gap: .35rem 1rem; flex-wrap: wrap; color: var(--bl-espresso); font-size: .84rem; font-weight: 800; }
  .bl-hero__trust li { display: inline-flex; align-items: center; gap: .3rem; }
  .bl-hero__cta { margin-top: 1.1rem; text-align: center; }

  /* CTA */
  .bl-cta { display: inline-flex; align-items: center; justify-content: center; gap: .6rem; min-height: 56px; padding: 0 1.6rem; border-radius: 16px; background: linear-gradient(180deg, var(--bl-copper-2), var(--bl-copper)); color: #fff !important; font: inherit; font-weight: 900; font-size: 1.05rem; box-shadow: 0 12px 28px rgba(180, 116, 67, .38); text-align: center; letter-spacing: -.01em; border: 0; cursor: pointer; }
  .bl-cta:active { transform: translateY(1px); }
  .bl-cta--wide { display: flex; width: 100%; max-width: 380px; margin: 0 auto; }
  .bl-cta--dark { background: linear-gradient(180deg, var(--bl-espresso-2), var(--bl-espresso)); box-shadow: 0 12px 28px rgba(58, 30, 17, .32); }
  .bl-cta--cream { background: var(--bl-cream); color: var(--bl-espresso) !important; box-shadow: 0 12px 26px rgba(0,0,0,.14); }

  /* Sections */
  .bl-section { padding: 42px 0; }
  .bl-section--cream { background: var(--bl-page-2); }
  .bl-section--dark { background: linear-gradient(180deg, var(--bl-espresso), var(--bl-espresso-2)); color: #fbe6c8; }
  .bl-section--dark .bl-heading { color: #fff2dc; }
  .bl-section--dark .bl-copy { color: #e5c9a4; }
  .bl-section__head { text-align: center; margin-bottom: 1.4rem; }
  .bl-section__head .bl-heading { margin-top: .55rem; }

  /* Desire tiles */
  .bl-desires { display: grid; gap: .85rem; }
  .bl-desire { display: flex; gap: 1rem; padding: 1.15rem 1.05rem; background: var(--bl-panel); border-radius: 20px; border: 1px solid var(--bl-line); box-shadow: var(--bl-shadow-sm); align-items: center; }
  .bl-desire__ic { flex: 0 0 56px; width: 56px; height: 56px; display: grid; place-items: center; border-radius: 16px; background: var(--bl-cream); color: var(--bl-espresso); font-size: 1.6rem; }
  .bl-desire:nth-child(2) .bl-desire__ic { background: #fbeed6; }
  .bl-desire:nth-child(3) .bl-desire__ic { background: #f3d9b7; }
  .bl-desire h3 { color: var(--bl-espresso); font-size: 1.05rem; font-weight: 900; }
  .bl-desire p { margin-top: .22rem !important; color: var(--bl-muted); font-size: .92rem; font-weight: 600; }

  /* Ingredients */
  .bl-ings { display: grid; grid-template-columns: repeat(2, 1fr); gap: .85rem; }
  .bl-ing { padding: 1.15rem .95rem 1.05rem; background: var(--bl-panel); border-radius: 20px; border: 1px solid var(--bl-line); box-shadow: var(--bl-shadow-sm); text-align: right; }
  .bl-ing__badge { width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; margin-bottom: .75rem; font-weight: 900; font-size: 1.25rem; color: #fff; box-shadow: 0 10px 22px rgba(58, 30, 17, .16); }
  .bl-ing:nth-child(1) .bl-ing__badge { background: linear-gradient(160deg, #d19b5c, #a86832); }
  .bl-ing:nth-child(2) .bl-ing__badge { background: linear-gradient(160deg, #b47443, #6d3b21); }
  .bl-ing:nth-child(3) .bl-ing__badge { background: linear-gradient(160deg, #e0b57a, #b57841); }
  .bl-ing:nth-child(4) .bl-ing__badge { background: linear-gradient(160deg, #4d2a1a, #251008); }
  .bl-ing h3 { color: var(--bl-espresso); font-size: 1rem; font-weight: 900; }
  .bl-ing p { margin-top: .25rem !important; color: var(--bl-muted); font-size: .86rem; font-weight: 600; line-height: 1.5; }

  /* Product showcase */
  .bl-show { display: grid; gap: 1.1rem; align-items: center; }
  .bl-show__media { border-radius: 24px; overflow: hidden; box-shadow: var(--bl-shadow-lg); background: #3a1e11; }
  .bl-show__media img { width: 100%; }
  .bl-show__facts { display: grid; gap: .6rem; }
  .bl-show__fact { display: flex; gap: .7rem; align-items: center; padding: .85rem 1rem; background: var(--bl-panel); border-radius: 14px; border: 1px solid var(--bl-line); font-weight: 800; color: var(--bl-espresso); font-size: .95rem; box-shadow: var(--bl-shadow-sm); }
  .bl-show__fact b { color: var(--bl-copper); font-weight: 900; }

  /* Coffee moment (dark inset) */
  .bl-moment { position: relative; margin: 32px 0; padding: 42px 0; background: linear-gradient(180deg, #4d2a1a, #3a1e11); color: #fbe6c8; overflow: hidden; }
  .bl-moment::before, .bl-moment::after { content: ""; position: absolute; inset-inline-start: -60px; top: -40px; width: 220px; height: 220px; border-radius: 50%; background: radial-gradient(circle, rgba(223, 168, 100, .18) 0%, transparent 70%); pointer-events: none; }
  .bl-moment::after { inset-inline-start: auto; inset-inline-end: -80px; top: auto; bottom: -60px; width: 260px; height: 260px; }
  .bl-moment__wrap { position: relative; display: grid; gap: 1.4rem; align-items: center; }
  .bl-moment__media { border-radius: 24px; overflow: hidden; box-shadow: var(--bl-shadow-lg); }
  .bl-moment__media img { width: 100%; }
  .bl-moment__title { color: #fff2dc; font-size: clamp(1.4rem, 5.8vw, 2rem); font-weight: 900; line-height: 1.2; }
  .bl-moment__title em { color: var(--bl-copper-2); font-style: normal; }
  .bl-moment__copy { margin-top: .8rem !important; color: #e5c9a4; font-size: 1rem; font-weight: 600; }

  /* Routine steps */
  .bl-steps { display: grid; gap: .8rem; margin-top: 1.1rem; }
  .bl-step { display: grid; grid-template-columns: 56px 1fr; gap: 1rem; align-items: center; padding: 1rem 1.1rem; background: var(--bl-panel); border-radius: 20px; border: 1px solid var(--bl-line); box-shadow: var(--bl-shadow-sm); }
  .bl-step__num { width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; background: linear-gradient(160deg, var(--bl-copper-2), var(--bl-copper)); color: #fff; font-weight: 900; font-size: 1.4rem; box-shadow: 0 10px 22px rgba(180, 116, 67, .28); }
  .bl-step h3 { color: var(--bl-espresso); font-size: 1rem; font-weight: 900; }
  .bl-step p { margin-top: .2rem !important; color: var(--bl-muted); font-size: .9rem; font-weight: 600; }
  .bl-steps__media { margin-top: 1.1rem; border-radius: 20px; overflow: hidden; box-shadow: var(--bl-shadow); }

  /* Full-width poster (image is the section) */
  .bl-poster { padding: 0; }
  .bl-poster__wrap { width: min(100% - 20px, 780px); margin: 22px auto; border-radius: 22px; overflow: hidden; box-shadow: var(--bl-shadow-lg); background: #fff; }
  .bl-poster__wrap img { width: 100%; height: auto; display: block; }
  .bl-poster--tight .bl-poster__wrap { margin: 12px auto; }
  .bl-poster--dark { background: #2b160c; }

  /* Order block — native inline COD form */
  .bl-order { scroll-margin-top: 16px; }
  .bl-order > .bl-wrap { width: min(100% - 12px, 780px); }
  .bl-order__frame { margin-top: 1rem; padding: 1.1rem .9rem; background: var(--bl-panel); border-radius: 26px; box-shadow: var(--bl-shadow-lg); border: 1px solid var(--bl-line); }
  @media (min-width: 750px) { .bl-order__frame { padding: 1.6rem 1.4rem; } }

  /* Hide any leftover EasySell app-embed form on the Bloom LP only —
     kept in the DOM (not display:none) so we can drive it programmatically
     when checkout_mode == 'easysell_bridge'. */
  body.template-product-bloom-uae #easysell,
  body.template-product-bloom-uae #es-form-container {
    position: fixed !important;
    inset-inline-start: -99999px !important;
    inset-block-start: -99999px !important;
    width: 1px !important;
    height: 1px !important;
    max-height: 1px !important;
    overflow: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
    visibility: hidden !important;
  }
  .bl-order__meta { margin: 0 0 .9rem; display: flex; flex-wrap: wrap; gap: .35rem .9rem; justify-content: center; color: var(--bl-muted); font-size: .82rem; font-weight: 800; text-align: center; }
  .bl-order__meta li { display: inline-flex; align-items: center; gap: .3rem; }
  .bl-order__meta b { color: var(--bl-espresso); }
  .bl-order__note { margin-top: .55rem; text-align: center; color: var(--bl-muted); font-size: .82rem; font-weight: 700; }

  /* Offer picker */
  .bl-offers { display: grid; gap: .6rem; margin: 0 0 1rem; }
  .bl-offer { position: relative; display: block; cursor: pointer; }
  .bl-offer input { position: absolute; opacity: 0; pointer-events: none; }
  .bl-offer__card { position: relative; display: grid; grid-template-columns: 26px 1fr auto; align-items: center; gap: .7rem; padding: .85rem .95rem; border-radius: 16px; border: 2px solid var(--bl-line); background: #fff; transition: border-color .15s ease, box-shadow .15s ease, transform .12s ease; }
  .bl-offer__radio { width: 22px; height: 22px; border-radius: 999px; border: 2px solid var(--bl-copper); position: relative; display: inline-block; }
  .bl-offer__radio::after { content:""; position:absolute; inset:4px; border-radius:999px; background: var(--bl-copper); transform: scale(0); transition: transform .15s ease; }
  .bl-offer input:checked + .bl-offer__card { border-color: var(--bl-copper); box-shadow: 0 10px 24px -12px rgba(180,116,67,.45); background: linear-gradient(180deg, #fff, #fff6ea); }
  .bl-offer input:checked + .bl-offer__card .bl-offer__radio::after { transform: scale(1); }
  .bl-offer__body { display: flex; flex-direction: column; gap: .1rem; min-width: 0; }
  .bl-offer__title { color: var(--bl-espresso); font-weight: 900; font-size: 1rem; line-height: 1.25; }
  .bl-offer__marketing { color: var(--bl-muted); font-weight: 700; font-size: .8rem; }
  .bl-offer__prices { text-align: end; display: flex; flex-direction: column; gap: .1rem; align-items: flex-end; }
  .bl-offer__now { color: var(--bl-espresso); font-weight: 900; font-size: 1.05rem; white-space: nowrap; }
  .bl-offer__was { color: #a08a75; font-weight: 700; font-size: .78rem; text-decoration: line-through; }
  .bl-offer__save { display: inline-block; margin-top: .15rem; padding: .12rem .55rem; border-radius: 999px; background: rgba(180,116,67,.14); color: var(--bl-copper); font-size: .7rem; font-weight: 900; letter-spacing: .02em; }
  .bl-offer__badge { position: absolute; inset-block-start: -10px; inset-inline-start: 14px; padding: .18rem .6rem; border-radius: 999px; background: linear-gradient(180deg, var(--bl-copper-2), var(--bl-copper)); color: #fff; font-size: .68rem; font-weight: 900; letter-spacing: .04em; box-shadow: 0 6px 12px rgba(180,116,67,.32); }
  .bl-offer--best .bl-offer__card { border-color: var(--bl-copper); box-shadow: 0 12px 26px -14px rgba(180,116,67,.4); }

  /* Buyer form */
  .bl-form { display: grid; gap: .65rem; }
  .bl-field { display: grid; gap: .28rem; }
  .bl-field > label { color: var(--bl-espresso); font-size: .84rem; font-weight: 800; }
  .bl-field > label .req { color: #c0392b; margin-inline-start: .18em; }
  .bl-field input,
  .bl-field select,
  .bl-field textarea { width: 100%; padding: .78rem .85rem; border-radius: 12px; border: 1.5px solid var(--bl-line); background: #fffdf9; color: var(--bl-espresso); font-family: inherit; font-size: 1rem; font-weight: 700; direction: rtl; }
  .bl-field input:focus,
  .bl-field select:focus,
  .bl-field textarea:focus { outline: 3px solid rgba(180,116,67,.28); outline-offset: 0; border-color: var(--bl-copper); }
  .bl-field input[dir="ltr"] { text-align: right; }
  .bl-field textarea { min-height: 78px; resize: vertical; }
  .bl-field--half { display: grid; gap: .65rem; }
  @media (min-width: 550px) { .bl-field--half { grid-template-columns: 1fr 1fr; } }
  .bl-form__submit { width: 100%; margin-top: .4rem; padding: 1rem 1.2rem; font-size: 1.05rem; border: 0; cursor: pointer; }
  .bl-form__submit[disabled] { opacity: .7; cursor: wait; }
  .bl-form__error { display: none; margin-top: .4rem; padding: .7rem .9rem; border-radius: 12px; background: #fdecea; color: #a03024; font-weight: 800; font-size: .88rem; text-align: center; }
  .bl-form__error.is-visible { display: block; }
  .bl-order__summary { margin: .8rem 0 1rem; padding: .8rem 1rem; border-radius: 14px; background: linear-gradient(180deg, #fff, #fbeed7); border: 1px solid var(--bl-line); display: flex; justify-content: space-between; align-items: center; gap: .6rem; color: var(--bl-espresso); font-weight: 900; }
  .bl-order__summary strong { color: var(--bl-copper); font-size: 1.15rem; }

  /* Trust bento */
  .bl-trust { display: grid; grid-template-columns: repeat(2, 1fr); gap: .7rem; margin-top: 1.2rem; }
  .bl-trust__item { display: flex; gap: .7rem; align-items: flex-start; padding: 1rem .9rem; background: var(--bl-panel); border-radius: 16px; border: 1px solid var(--bl-line); box-shadow: var(--bl-shadow-sm); }
  .bl-trust__ic { flex: 0 0 40px; width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; background: var(--bl-cream); font-size: 1.15rem; }
  .bl-trust__item strong { display: block; color: var(--bl-espresso); font-size: .95rem; }
  .bl-trust__item span { display: block; color: var(--bl-muted); font-size: .8rem; font-weight: 600; margin-top: .14rem; }
  .bl-trust__item b { color: var(--bl-espresso); }
  .bl-trust__note { margin-top: 1rem; padding: .95rem 1.1rem; border-radius: 16px; background: rgba(255, 255, 255, .6); border: 1px dashed var(--bl-line); color: var(--bl-espresso); font-size: .88rem; font-weight: 800; text-align: center; }
  .bl-trust__note a { color: var(--bl-copper); text-decoration: underline; text-underline-offset: 3px; font-weight: 900; }

  /* Why block */
  .bl-why { display: grid; gap: .8rem; }
  .bl-why__card { padding: 1.1rem 1rem; background: rgba(255, 233, 200, .06); border-radius: 18px; border: 1px solid rgba(255, 233, 200, .12); }
  .bl-why__ic { display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 14px; background: rgba(223, 168, 100, .18); color: var(--bl-gold); margin-bottom: .6rem; font-size: 1.3rem; }
  .bl-why__card h3 { color: #fff2dc; font-size: 1.05rem; font-weight: 900; }
  .bl-why__card p { margin-top: .22rem !important; color: #e5c9a4; font-size: .92rem; font-weight: 600; }
  .bl-eyebrow--dark { background: rgba(223, 168, 100, .18); color: var(--bl-gold); }

  /* FAQ */
  .bl-faq { display: grid; gap: .55rem; }
  .bl-faq details { background: var(--bl-panel); border: 1px solid var(--bl-line); border-radius: 16px; padding: 0; box-shadow: var(--bl-shadow-sm); overflow: hidden; }
  .bl-faq summary { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1rem 1.1rem; color: var(--bl-espresso); cursor: pointer; font-weight: 900; list-style: none; }
  .bl-faq summary::-webkit-details-marker { display: none; }
  .bl-faq summary::after { content: "+"; color: var(--bl-copper); font-weight: 900; font-size: 1.4rem; line-height: 1; }
  .bl-faq details[open] summary::after { content: "−"; }
  .bl-faq p { padding: 0 1.1rem 1rem; color: var(--bl-muted); font-size: .92rem; font-weight: 600; }
  .bl-faq a { color: var(--bl-copper); text-decoration: underline; text-underline-offset: 3px; font-weight: 900; }

  /* Final CTA */
  .bl-final { position: relative; text-align: center; background:
    radial-gradient(80% 60% at 50% 0%, rgba(223, 168, 100, .28), transparent 70%),
    linear-gradient(160deg, #3a1e11 0%, #4d2a1a 40%, #2b160c 100%);
    color: #fff2dc; overflow: hidden; }
  .bl-final .bl-heading { color: #fff2dc; }
  .bl-final .bl-copy { color: #e5c9a4; }
  .bl-final__media { max-width: 300px; margin: 1.2rem auto 1rem; border-radius: 20px; overflow: hidden; box-shadow: var(--bl-shadow-lg); }
  .bl-final__media img { width: 100%; }
  .bl-final__prices { margin-top: 1.1rem; display: flex; justify-content: center; gap: .5rem; flex-wrap: wrap; color: #fff2dc; font-weight: 900; }
  .bl-final__prices span { padding: .35rem .7rem; border-radius: 999px; background: rgba(255, 233, 200, .1); border: 1px solid rgba(255, 233, 200, .25); font-size: .8rem; }
  .bl-final__cta { margin-top: 1.15rem; }

  /* Sticky CTA */
  .bl-sticky { position: fixed; z-index: 25; inset-inline: 12px; bottom: max(10px, env(safe-area-inset-bottom)); min-height: 56px; transition: transform .18s ease, opacity .18s ease; }
  body.bl-order-visible .bl-sticky { transform: translateY(140%); opacity: 0; pointer-events: none; }

  /* ============ LOCAL HEADER ============ */
  .bl-header { position: sticky; top: 0; z-index: 40; background: rgba(251, 244, 234, .96); backdrop-filter: saturate(140%) blur(8px); -webkit-backdrop-filter: saturate(140%) blur(8px); border-bottom: 1px solid var(--bl-line); }
  .bl-header__inner { width: min(100% - 20px, 1180px); margin: 0 auto; padding: .55rem 0; display: flex; align-items: center; justify-content: space-between; gap: .6rem; }
  .bl-header__brand { display: inline-flex; align-items: center; gap: .5rem; color: var(--bl-espresso); font-weight: 900; letter-spacing: -.01em; }
  .bl-header__brand-mark { color: var(--bl-copper); font-size: 1.2rem; line-height: 1; transform: translateY(-1px); }
  .bl-header__brand-name { font-size: 1.05rem; }
  .bl-header__brand-sub { color: var(--bl-copper); font-size: .68rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  .bl-header__nav { display: none; align-items: center; gap: 1.3rem; font-size: .92rem; font-weight: 800; color: var(--bl-espresso); }
  .bl-header__nav a { position: relative; padding: .3rem 0; transition: color .15s ease; }
  .bl-header__nav a::after { content:""; position: absolute; inset-inline: 0; bottom: 0; height: 2px; background: var(--bl-copper); transform: scaleX(0); transform-origin: right; transition: transform .18s ease; }
  .bl-header__nav a:hover { color: var(--bl-copper); }
  .bl-header__nav a:hover::after { transform: scaleX(1); }
  .bl-header__cta { display: inline-flex; align-items: center; gap: .35rem; padding: .55rem 1.05rem; border-radius: 999px; background: linear-gradient(180deg, var(--bl-copper-2), var(--bl-copper)); color: #fff !important; font-weight: 900; font-size: .92rem; box-shadow: 0 8px 20px rgba(180, 116, 67, .32); white-space: nowrap; }
  .bl-header__cta:hover { transform: translateY(-1px); box-shadow: 0 12px 24px rgba(180, 116, 67, .42); }
  .bl-header__burger { display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; width: 40px; height: 40px; padding: 0; border: 1px solid var(--bl-line); background: #fff; border-radius: 10px; cursor: pointer; }
  .bl-header__burger span { display: block; width: 18px; height: 2px; background: var(--bl-espresso); border-radius: 2px; transition: transform .2s ease, opacity .2s ease; }
  .bl-header.is-open .bl-header__burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .bl-header.is-open .bl-header__burger span:nth-child(2) { opacity: 0; }
  .bl-header.is-open .bl-header__burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .bl-header__drawer { display: none; flex-direction: column; gap: .35rem; padding: .5rem 12px 1rem; border-top: 1px solid var(--bl-line); background: rgba(251, 244, 234, .98); }
  .bl-header__drawer:not([hidden]) { display: flex; }
  .bl-header__drawer a { padding: .8rem .8rem; border-radius: 12px; font-weight: 800; color: var(--bl-espresso); background: rgba(255,255,255,.7); }
  .bl-header__drawer-cta { background: linear-gradient(180deg, var(--bl-copper-2), var(--bl-copper)) !important; color: #fff !important; text-align: center; box-shadow: 0 8px 20px rgba(180, 116, 67, .32); }
  @media (min-width: 750px) {
    .bl-header__nav { display: inline-flex; }
    .bl-header__burger { display: none; }
    .bl-header__drawer { display: none !important; }
  }

  /* Desktop layout */
  @media (min-width: 700px) {
    #bloom-uae-lp { padding-bottom: 0; }
    .bl-section { padding: 60px 0; }
    .bl-desires { grid-template-columns: repeat(3, 1fr); }
    .bl-ings { grid-template-columns: repeat(4, 1fr); }
    .bl-show { grid-template-columns: 1fr 1fr; gap: 2rem; }
    .bl-moment__wrap { grid-template-columns: 1fr 1fr; gap: 2rem; }
    .bl-trust { grid-template-columns: repeat(4, 1fr); }
    .bl-why { grid-template-columns: repeat(3, 1fr); }
    .bl-hero__frame { max-width: 520px; margin-inline: auto; aspect-ratio: 1086 / 1448; }
    .bl-sticky { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bl-sticky, .bl-offer { transition: none; }
  }

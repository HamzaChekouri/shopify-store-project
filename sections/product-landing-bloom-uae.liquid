{% javascript %}
  (function () {
    var root = document.getElementById('bloom-uae-lp');
    if (!root) return;
    var form = root.querySelector('#bloom-order-form');
    var quantity = root.querySelector('[data-bloom-quantity]');
    var offers = root.querySelectorAll('input[name="bloom-offer"]');
    var orderSection = root.querySelector('#lp-order');
    if (form && quantity) {
      offers.forEach(function (offer) {
        offer.addEventListener('change', function () {
          quantity.value = offer.value;
          quantity.dispatchEvent(new Event('input', { bubbles: true }));
          quantity.dispatchEvent(new Event('change', { bubbles: true }));
        });
      });
    }
    if (orderSection && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          document.body.classList.toggle('bl-order-visible', entry.isIntersecting);
        });
      }, { threshold: 0.18 }).observe(orderSection);
    }
  })();
{% endjavascript %}


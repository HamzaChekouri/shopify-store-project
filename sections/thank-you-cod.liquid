        {%- endcomment -%}
        <p class="ty-summary__meta" data-ty-qty-row hidden>
          الكمية:
          <span data-ty-qty></span>
        </p>
        <p class="ty-summary__total" data-ty-price-row hidden>
          الإجمالي:
          <span class="ty-summary__price">
            <span data-ty-price></span>
            <span data-ty-currency></span>
          </span>
        </p>

        <ul class="ty-summary__badges">
          <li><span aria-hidden="true">✅</span> تم استلام طلبك</li>
          <li><span aria-hidden="true">💵</span> الدفع عند الاستلام</li>
          <li><span aria-hidden="true">🚚</span> التوصيل داخل الإمارات</li>
        </ul>

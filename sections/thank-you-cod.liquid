{%- comment -%}
  Commitment CTA — vanilla JS, ~40 lines, no libraries.
  - Reads/writes only one localStorage key: `ty_cod_commitment_v1`.
  - Toggles a data-state attribute; CSS handles the visible change.
  - `type="button"` guarantees no form submission.
  - No fetch, no beacon, no pixel call: cannot affect Purchase attribution.
{%- endcomment -%}
<script>
  (function () {
    'use strict';
    var STORAGE_KEY = 'ty_cod_commitment_v1';
    var root = document.getElementById('ty-cod');
    if (!root) return;

    var wrap = root.querySelector('[data-ty-commitment]');
    var btn  = root.querySelector('[data-ty-commit-btn]');
    if (!wrap || !btn) return;

    function safeGet() {
      try { return localStorage.getItem(STORAGE_KEY); } catch (e) { return null; }
    }
    function safeSet(v) {
      try { localStorage.setItem(STORAGE_KEY, v); } catch (e) { /* ignore */ }
    }

    function apply(state) {
      if (state === 'yes') {
        wrap.setAttribute('data-state', 'committed');
        btn.setAttribute('aria-pressed', 'true');
        btn.setAttribute('disabled', 'disabled');
      } else {
        wrap.removeAttribute('data-state');
        btn.setAttribute('aria-pressed', 'false');
        btn.removeAttribute('disabled');
      }
    }

    // Hydrate from previous session (survives refresh).
    if (safeGet() === 'yes') apply('yes');

    btn.addEventListener('click', function (event) {
      // Defensive: this button is type="button", but guard anyway.
      event.preventDefault();
      if (btn.getAttribute('aria-pressed') === 'true') return;
      apply('yes');
      safeSet('yes');
    });
  })();
</script>

{% stylesheet %}
  /* ============================================================
     Bubble Mousse — Thank You (COD) page
     All selectors are scoped under `#ty-cod` or the body template
     class to guarantee zero bleed to other Shopify pages.
     ============================================================ */

  /* Hide theme chrome only on this page. */
  body.template-page-thank-you-cod #header-component,
  body.template-page-thank-you-cod header.header,
  body.template-page-thank-you-cod .shopify-section-header,
  body.template-page-thank-you-cod .shopify-section-group-header-group,
  body.template-page-thank-you-cod .header-wrapper,
  body.template-page-thank-you-cod .announcement-bar,
  body.template-page-thank-you-cod .utility-bar,
  body.template-page-thank-you-cod .shopify-section-footer,
  body.template-page-thank-you-cod footer.footer {
    display: none !important;
  }
  body.template-page-thank-you-cod { background: #f5efe4; }

  #ty-cod {
    --ty-bg:         #f5efe4;
    --ty-panel:      #ffffff;
    --ty-green-dk:   #1e4a2b;
    --ty-green:      #2f6b3f;
    --ty-green-sft:  #dfeadf;
    --ty-gold:       #b48a3a;
    --ty-gold-sft:   #f6ecd4;
    --ty-text:       #1f2b21;
    --ty-muted:      #5c6b5e;
    --ty-border:     rgba(31, 43, 33, 0.10);
    --ty-shadow-sm:  0 4px 14px rgba(20, 40, 25, 0.06);
    --ty-shadow-md:  0 12px 30px rgba(20, 40, 25, 0.09);
    --ty-radius:     16px;
    --ty-radius-sm:  12px;

    background: var(--ty-bg);
    color: var(--ty-text);
    font-family: 'DIN Next LT Arabic', 'Almarai', 'Cairo', 'Tajawal', system-ui, -apple-system, 'Segoe UI', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    direction: rtl;
    text-align: right;
    overflow-x: clip;
    min-height: 100vh;
    padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 1rem);
  }

  /* Scoped resets — inside container only. */
  #ty-cod *,
  #ty-cod *::before,
  #ty-cod *::after { box-sizing: border-box; min-width: 0; }
  #ty-cod img,
  #ty-cod svg     { max-width: 100%; display: block; }
  #ty-cod h1,
  #ty-cod h2,
  #ty-cod h3,
  #ty-cod p,
  #ty-cod ul,
  #ty-cod ol      { margin: 0; padding: 0; }
  #ty-cod ul,
  #ty-cod ol      { list-style: none; }
  #ty-cod a       { color: inherit; text-decoration: none; }
  #ty-cod strong  { font-weight: 800; }

  /* +971 renders LTR while staying inside RTL flow. */
  #ty-cod [dir="ltr"] {
    unicode-bidi: isolate;
    display: inline-block;
    direction: ltr;
  }

  /* ============ HERO ============ */
  .ty-hero {
    padding: 1.75rem 1rem 1rem;
    text-align: center;
    background: linear-gradient(180deg, var(--ty-green-sft) 0%, var(--ty-bg) 100%);
  }
  .ty-hero__inner {
    max-width: 560px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
  }
  .ty-success {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #fff;
    color: var(--ty-green-dk);
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 800;
    box-shadow: var(--ty-shadow-sm);
    border: 1px solid var(--ty-green-sft);
  }
  .ty-success__ic { color: var(--ty-green); }
  .ty-hero__title {
    font-size: clamp(1.35rem, 4vw + 0.5rem, 1.85rem);
    font-weight: 800;
    color: var(--ty-green-dk);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .ty-hero__urgent {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--ty-gold-sft);
    color: #7a5a1a;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 800;
    border: 1px solid rgba(180, 138, 58, 0.25);
  }
  .ty-hero__lead {
    color: var(--ty-text);
    font-size: 0.95rem;
    max-width: 42ch;
    line-height: 1.55;
  }
  .ty-hero__next {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ty-muted);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    margin-top: 0.15rem;
  }
  .ty-hero__next-line {
    flex: 1;
    height: 1px;
    background: var(--ty-border);
    max-width: 36px;
  }

  /* ============ SECTIONS ============ */
  .ty-section {
    padding: 1rem;
    max-width: 720px;
    margin: 0 auto;
  }
  .ty-section--tight { padding-top: 0.35rem; }
  .ty-head {
    text-align: center;
    margin: 0 auto 0.9rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }
  .ty-head h2 {
    font-size: clamp(1.1rem, 2vw + 0.6rem, 1.35rem);
    font-weight: 800;
    color: var(--ty-green-dk);
    line-height: 1.35;
  }
  .ty-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--ty-green-sft);
    color: var(--ty-green-dk);
    font-weight: 800;
    font-size: 0.8rem;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
  }
  .ty-tick { color: var(--ty-green); font-weight: 900; flex-shrink: 0; }

  /* ============ CALL CARD + CTA ============ */
  .ty-call {
    background: #fff;
    border: 2px solid var(--ty-gold);
    border-radius: var(--ty-radius);
    padding: 1rem;
    box-shadow: var(--ty-shadow-md);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .ty-call__row {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
  }
  .ty-call__ic {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--ty-green-sft);
    border-radius: 10px;
    font-size: 1.15rem;
    line-height: 1;
  }
  .ty-call__row--prefix .ty-call__ic {
    background: var(--ty-gold-sft);
  }
  .ty-call__row-body { flex: 1; min-width: 0; }
  .ty-call__row-body strong {
    display: block;
    font-size: 0.98rem;
    color: var(--ty-green-dk);
    font-weight: 800;
    line-height: 1.35;
  }
  .ty-call__row-body span:not(.ty-prefix) {
    display: block;
    font-size: 0.86rem;
    color: var(--ty-muted);
    line-height: 1.5;
    margin-top: 0.1rem;
  }
  .ty-prefix {
    color: var(--ty-gold);
    font-weight: 900;
    font-size: 1.05em;
    letter-spacing: 0.02em;
    padding: 0 0.15em;
  }
  .ty-call__reinforce {
    background: var(--ty-gold-sft);
    color: #6a4a10;
    border-radius: var(--ty-radius-sm);
    padding: 0.65rem 0.8rem;
    font-size: 0.9rem;
    line-height: 1.55;
    font-weight: 600;
  }

  /* Commitment CTA — 48px tall, full-width, high-contrast. */
  .ty-cta {
    -webkit-appearance: none;
    appearance: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 52px;
    padding: 0.85rem 1rem;
    background: var(--ty-green-dk);
    color: #fff;
    border: 0;
    border-radius: var(--ty-radius-sm);
    font-family: inherit;
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.3;
    cursor: pointer;
    box-shadow: 0 8px 18px rgba(30, 74, 43, 0.22);
    transition: transform 0.15s ease, background 0.2s ease;
    text-align: center;
  }
  .ty-cta:hover  { transform: translateY(-1px); }
  .ty-cta:active { transform: translateY(0); }
  .ty-cta:focus-visible {
    outline: 3px solid var(--ty-gold);
    outline-offset: 2px;
  }
  .ty-cta__default { display: inline-flex; align-items: center; gap: 0.5rem; }
  .ty-cta__done    { display: none; align-items: center; gap: 0.5rem; }

  [data-ty-commitment][data-state="committed"] .ty-cta {
    background: var(--ty-green);
    box-shadow: none;
    cursor: default;
    opacity: 1;
  }
  [data-ty-commitment][data-state="committed"] .ty-cta__default { display: none; }
  [data-ty-commitment][data-state="committed"] .ty-cta__done    { display: inline-flex; }

  .ty-cta[disabled] { transform: none; }

  .ty-call__note {
    background: #fafaf5;
    border-inline-start: 3px solid var(--ty-gold);
    border-radius: var(--ty-radius-sm);
    padding: 0.55rem 0.75rem;
    font-size: 0.85rem;
    color: var(--ty-text);
    line-height: 1.55;
  }
  .ty-call__note strong { color: var(--ty-green-dk); }

  /* ============ ORDER SUMMARY ============ */
  .ty-summary {
    background: #fff;
    border-radius: var(--ty-radius);
    border: 1px solid var(--ty-border);
    box-shadow: var(--ty-shadow-sm);
    padding: 0.9rem;
    display: flex;
    gap: 0.85rem;
    align-items: center;
  }
  .ty-summary__media {
    flex-shrink: 0;
    width: 92px;
    height: 92px;
    border-radius: var(--ty-radius-sm);
    background: var(--ty-green-sft);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .ty-summary__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .ty-summary__body { flex: 1; min-width: 0; }
  .ty-summary__title {
    font-size: 1.02rem;
    font-weight: 800;
    color: var(--ty-green-dk);
    line-height: 1.35;
    margin-bottom: 0.25rem;
  }
  .ty-summary__meta {
    font-size: 0.88rem;
    color: var(--ty-muted);
    line-height: 1.5;
  }
  .ty-summary__total {
    font-size: 0.95rem;
    color: var(--ty-text);
    font-weight: 700;
    margin-top: 0.15rem;
  }
  .ty-summary__price {
    color: var(--ty-gold);
    font-weight: 900;
  }
  .ty-summary__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    margin-top: 0.5rem;
  }
  .ty-summary__badges li {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ty-green-dk);
    background: var(--ty-green-sft);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  /* ============ AUTHENTICITY ============ */
  .ty-auth {
    background: #fff;
    border: 1px solid var(--ty-border);
    border-radius: var(--ty-radius);
    padding: 1rem;
    box-shadow: var(--ty-shadow-sm);
    display: flex;
    gap: 0.9rem;
    align-items: center;
  }
  .ty-auth__media {
    flex-shrink: 0;
    width: 108px;
    height: 108px;
    border-radius: var(--ty-radius-sm);
    background: var(--ty-green-sft);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .ty-auth__img { width: 100%; height: 100%; object-fit: contain; }
  .ty-auth__body { flex: 1; min-width: 0; }
  .ty-auth__lead {
    font-size: 0.9rem;
    color: var(--ty-text);
    line-height: 1.55;
    margin-bottom: 0.5rem;
  }
  .ty-auth__ticks {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.3rem;
  }
  .ty-auth__ticks li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--ty-text);
    font-weight: 600;
  }

  /* ============ BENEFITS ============ */
  .ty-benefits {
    background: #fff;
    border: 1px solid var(--ty-border);
    border-radius: var(--ty-radius);
    padding: 0.85rem 1rem;
    box-shadow: var(--ty-shadow-sm);
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.45rem;
  }
  .ty-benefits li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.92rem;
    color: var(--ty-text);
    font-weight: 600;
    line-height: 1.5;
  }

  /* ============ STEPS ============ */
  .ty-steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.55rem;
  }
  .ty-step {
    background: #fff;
    border: 1px solid var(--ty-border);
    border-radius: var(--ty-radius);
    padding: 0.85rem 0.95rem;
    box-shadow: var(--ty-shadow-sm);
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .ty-step__ic {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    background: var(--ty-green-sft);
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    line-height: 1;
  }
  .ty-step__body { flex: 1; min-width: 0; }
  .ty-step__body strong {
    display: block;
    font-size: 0.98rem;
    color: var(--ty-green-dk);
    line-height: 1.35;
  }
  .ty-step__body span {
    display: block;
    font-size: 0.85rem;
    color: var(--ty-muted);
    line-height: 1.5;
    margin-top: 0.15rem;
  }
  .ty-steps__note {
    margin-top: 0.6rem;
    text-align: center;
    color: var(--ty-green-dk);
    font-weight: 700;
    font-size: 0.9rem;
  }

  /* ============ REVIEWS ============ */
  .ty-reviews {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.6rem;
  }
  .ty-review {
    background: #fff;
    border: 1px solid var(--ty-border);
    border-radius: var(--ty-radius);
    padding: 0.9rem 1rem;
    box-shadow: var(--ty-shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .ty-review__stars {
    color: #f5b400;
    letter-spacing: 2px;
    font-size: 0.9rem;
    line-height: 1;
  }
  .ty-review p {
    font-size: 0.9rem;
    color: var(--ty-text);
    line-height: 1.65;
  }
  .ty-review__foot {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .ty-review__avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .ty-review__meta {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .ty-review__meta strong {
    font-size: 0.88rem;
    color: var(--ty-text);
    font-weight: 800;
  }
  .ty-review__meta span {
    font-size: 0.76rem;
    color: var(--ty-muted);
  }

  /* ============ USAGE ============ */
  .ty-usage {
    background: #fff;
    border: 1px solid var(--ty-border);
    border-radius: var(--ty-radius);
    padding: 0.5rem;
    box-shadow: var(--ty-shadow-sm);
    overflow: hidden;
  }
  .ty-usage__img {
    width: 100%;
    height: auto;
    border-radius: var(--ty-radius-sm);
  }

  /* ============ SUPPORT ============ */
  .ty-support__inner {
    background: linear-gradient(135deg, var(--ty-green-dk), var(--ty-green));
    color: #fff;
    border-radius: var(--ty-radius);
    padding: 1.25rem 1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    box-shadow: var(--ty-shadow-md);
  }
  .ty-support__inner h2 {
    font-size: 1.1rem;
    font-weight: 800;
    color: #fff;
    line-height: 1.35;
  }
  .ty-support__inner p {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.9);
    line-height: 1.55;
    max-width: 40ch;
  }
  .ty-support__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: #25d366;
    color: #fff !important;
    padding: 0.7rem 1.25rem;
    border-radius: 999px;
    font-weight: 800;
    font-size: 0.95rem;
    min-height: 44px;
    box-shadow: 0 6px 14px rgba(37,211,102,0.28);
    transition: transform 0.15s ease;
    margin-top: 0.25rem;
  }
  .ty-support__cta:hover { transform: translateY(-1px); }

  /* ============ FOOTER ============ */
  .ty-foot {
    padding: 1.5rem 1rem 1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    max-width: 720px;
    margin: 0 auto;
  }
  .ty-foot__msg { font-size: 0.9rem; color: var(--ty-green-dk); font-weight: 700; }
  .ty-foot__msg strong { color: var(--ty-gold); }
  .ty-foot__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    justify-content: center;
  }
  .ty-foot__nav a {
    font-size: 0.8rem;
    color: var(--ty-muted);
    border-bottom: 1px dashed transparent;
  }
  .ty-foot__nav a:hover {
    color: var(--ty-green-dk);
    border-bottom-color: var(--ty-green-dk);
  }
  .ty-foot__copy { font-size: 0.75rem; color: var(--ty-muted); }

  /* ============ SMALL PHONES (≤ 360px) ============ */
  @media (max-width: 360px) {
    #ty-cod { font-size: 15px; }
    .ty-hero { padding: 1.35rem 0.85rem 0.85rem; }
    .ty-section { padding: 0.85rem; }
    .ty-summary__media { width: 80px; height: 80px; }
    .ty-auth__media   { width: 92px;  height: 92px; }
    .ty-call__ic,
    .ty-step__ic     { width: 36px; height: 36px; font-size: 1.05rem; }
    .ty-cta          { font-size: 0.95rem; min-height: 48px; }
  }

  /* ============ DESKTOP ============ */
  @media (min-width: 750px) {
    .ty-hero { padding: 2.5rem 1rem 1.5rem; }
    .ty-section { padding: 1.5rem 1rem; }
    .ty-steps { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .ty-reviews { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .ty-benefits { grid-template-columns: 1fr 1fr; }
    .ty-auth { padding: 1.25rem; }
    .ty-auth__media { width: 140px; height: 140px; }
    .ty-summary { padding: 1.1rem; }
    .ty-summary__media { width: 108px; height: 108px; }
    .ty-usage__img { max-width: 640px; margin: 0 auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ty-cta { transition: none; }
    .ty-cta:hover,
    .ty-support__cta:hover { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Thank You (COD)",
  "tag": "section",
  "class": "ty-cod-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Call confirmation"
    },
    {
      "type": "text",
      "id": "call_window",
      "label": "Call time-window",
      "default": "أقل من 10 دقائق"
    },
    {

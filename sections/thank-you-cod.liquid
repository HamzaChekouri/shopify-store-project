      "id": "call_prefix",
      "label": "Country phone prefix",
      "default": "+971"
    },
    {
      "type": "header",
      "content": "Order summary (product name only)"
    },
    {
      "type": "paragraph",
      "content": "Quantity and price are intentionally NOT shown until real order data is hydrated. Do not fabricate values."
    },
    {
      "type": "text",
      "id": "product_title",
      "label": "Product title",
      "default": "شامبو بابل موس"
    },
    {
      "type": "header",
      "content": "Support"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp number (international, no +)",
      "default": "971542585701"
    }
  ],
  "presets": [
    {
      "name": "Thank You (COD)",
      "category": "Custom"
    }
  ]
}
{% endschema %}

{%- comment -%}
  Bloom UAE LP — Isolated footer scoped to #bloom-uae-footer.
  Palette matches the Bloom Collagen Coffee packaging.
{%- endcomment -%}

{%- liquid
  assign wa_number = section.settings.whatsapp_number | default: '971542585701'
  assign email     = section.settings.email          | default: shop.email
  assign brand     = section.settings.brand_name     | default: 'بلوم كولاجين'
  assign brand_latin = section.settings.brand_latin  | default: 'BLOOM COFFEE'
  assign year = 'now' | date: '%Y'
-%}

<footer id="bloom-uae-footer" class="bl-footer" dir="rtl" lang="ar">
  <div class="bl-footer__inner">

    <div class="bl-footer__brand">
      <div class="bl-footer__logo">
        <span class="bl-footer__logo-mark" aria-hidden="true">✦</span>
        <div class="bl-footer__logo-text">
          <strong>{{ brand }}</strong>
          <span>{{ brand_latin }}</span>
        </div>
      </div>
      <p class="bl-footer__tagline">
        قهوة الكولاجين والبروبيوتيك اليومية — تدعم إدارة الوزن، الهضم، وإشراقة البشرة.
      </p>
      <ul class="bl-footer__trust" aria-label="ضمانات">
        <li>✓ الدفع عند الاستلام</li>
        <li>✓ توصيل 1–2 يوم داخل الإمارات</li>
        <li>✓ ضمان الجودة</li>
      </ul>
    </div>

    <nav class="bl-footer__col" aria-label="المتجر">
      <h3>المتجر</h3>
      <a href="#lp-order">اطلب الآن</a>
      <a href="#lp-benefits">فوائد بلوم</a>
      <a href="#lp-how">طريقة الاستعمال</a>
      <a href="#top">الرئيسية</a>
    </nav>

    <nav class="bl-footer__col" aria-label="المساعدة">
      <h3>المساعدة</h3>
      <a href="#lp-faq">الأسئلة الشائعة</a>
      <a href="{{ routes.root_url }}pages/shippingpolicies">سياسة الشحن</a>
      <a href="{{ routes.root_url }}pages/returnpolities">سياسة الاسترجاع</a>
      <a href="{{ routes.root_url }}pages/privacy">سياسة الخصوصية</a>
    </nav>

    <div class="bl-footer__col bl-footer__col--contact" aria-label="تواصل معنا">
      <h3>تواصل معنا</h3>
      <a
        class="bl-footer__wa"
        href="https://wa.me/{{ wa_number }}"
        target="_blank"
        rel="noopener"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
          <path d="M12.04 2C6.58 2 2.15 6.43 2.15 11.89c0 1.96.55 3.83 1.6 5.44L2 22l4.79-1.27a9.87 9.87 0 0 0 5.25 1.5h.01c5.46 0 9.89-4.43 9.89-9.89S17.5 2 12.04 2zM17.4 15.9c-.23.65-1.32 1.18-1.85 1.25-.47.07-1.05.09-1.7-.12-.4-.14-.9-.31-1.55-.6-2.72-1.18-4.5-3.94-4.63-4.12-.13-.18-1.11-1.47-1.11-2.8s.7-1.99.95-2.26c.25-.27.55-.34.73-.34.18 0 .36 0 .52.01.17.01.4-.06.62.47.23.55.79 1.92.86 2.06.07.14.12.31.02.5-.09.19-.14.31-.28.47-.14.16-.29.36-.42.48-.14.14-.28.29-.12.57.16.28.72 1.19 1.55 1.93 1.07.95 1.97 1.24 2.25 1.38.28.14.44.12.6-.07.16-.19.7-.82.88-1.1.18-.28.37-.23.62-.14.25.09 1.6.75 1.88.89.28.14.46.21.53.32.07.11.07.64-.16 1.29z"/>
        </svg>
        واتساب: +{{ wa_number }}
      </a>
      {% if email != blank %}
        <a href="mailto:{{ email }}" class="bl-footer__link">
          <span class="bl-footer__ico" aria-hidden="true">✉</span>
          {{ email }}
        </a>
      {% endif %}
      <p class="bl-footer__addr">توصيل داخل جميع إمارات دولة الإمارات العربية المتحدة</p>
    </div>
  </div>

  <div class="bl-footer__bar">
    <div class="bl-footer__bar-inner">
      <div class="bl-footer__pay" aria-label="طرق الدفع">
        <span class="bl-pay bl-pay--cod">COD</span>
        <span class="bl-pay bl-pay--visa">VISA</span>
        <span class="bl-pay bl-pay--mc">Mastercard</span>
        <span class="bl-pay bl-pay--apple">Apple Pay</span>
      </div>
      <p class="bl-footer__copy">© {{ year }} {{ brand }} · جميع الحقوق محفوظة.</p>
    </div>
  </div>
</footer>

{% style %}
  /* All rules scoped to #bloom-uae-footer to avoid theme bleed */

  #bloom-uae-footer {
    background: #2a1408;
    color: #f3e1c6;
    font-family: 'DIN Next LT Arabic', 'Almarai', 'Cairo', 'Tajawal', system-ui, -apple-system, Segoe UI, sans-serif;
    direction: rtl;
    text-align: right;
    line-height: 1.7;
    font-size: 15px;
    padding-bottom: env(safe-area-inset-bottom);
  }
  #bloom-uae-footer *, #bloom-uae-footer *::before, #bloom-uae-footer *::after { box-sizing: border-box; }
  #bloom-uae-footer a { color: inherit; text-decoration: none; transition: color .15s ease, opacity .15s ease; }
  #bloom-uae-footer a:hover { color: #ffffff; opacity: 1; }

  #bloom-uae-footer h3 {
    color: #ffffff;
    font-size: .98rem;
    font-weight: 900;
    letter-spacing: .01em;
    margin: 0 0 .85rem;
    position: relative;
    padding-bottom: .55rem;
  }
  #bloom-uae-footer h3::after {
    content: '';
    position: absolute;
    bottom: 0;
    inset-inline-end: 0;
    width: 28px;
    height: 2px;
    background: #dfa864;
    border-radius: 2px;
  }

  .bl-footer__inner {
    width: min(1180px, 100%);
    margin: 0 auto;
    padding: 2.25rem 1.15rem 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  .bl-footer__brand { display: flex; flex-direction: column; gap: .9rem; }
  .bl-footer__logo { display: flex; align-items: center; gap: .6rem; }
  .bl-footer__logo-mark { color: #dfa864; font-size: 1.6rem; line-height: 1; }
  .bl-footer__logo-text { display: flex; flex-direction: column; gap: .1rem; }
  .bl-footer__logo-text strong { color: #ffffff; font-size: 1.15rem; font-weight: 900; line-height: 1.1; }
  .bl-footer__logo-text span { color: #dfa864; font-size: .72rem; font-weight: 700; letter-spacing: .18em; }
  .bl-footer__tagline { color: rgba(243, 225, 198, .82); margin: 0; font-size: .92rem; line-height: 1.75; max-width: 44ch; }
  .bl-footer__trust { list-style: none; padding: 0; margin: .4rem 0 0; display: flex; flex-wrap: wrap; gap: .4rem .85rem; font-size: .82rem; color: rgba(243, 225, 198, .85); font-weight: 600; }
  .bl-footer__trust li { display: inline-flex; }

  .bl-footer__col { display: flex; flex-direction: column; gap: .55rem; font-size: .92rem; }
  .bl-footer__col a { color: rgba(243, 225, 198, .88); padding: .15rem 0; }
  .bl-footer__col a:hover { color: #ffffff; }

  .bl-footer__col--contact a { display: inline-flex; align-items: center; gap: .55rem; color: #ffffff; font-weight: 700; }
  .bl-footer__wa {
    background: #25d366;
    color: #0f2417 !important;
    padding: .55rem .95rem !important;
    border-radius: 999px;
    align-self: flex-start;
    font-weight: 800;
    font-size: .9rem;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .bl-footer__wa:hover { transform: translateY(-1px); box-shadow: 0 8px 20px rgba(37, 211, 102, .35); color: #0f2417 !important; }
  .bl-footer__link .bl-footer__ico {
    display: inline-flex; width: 26px; height: 26px;
    background: rgba(223, 168, 100, .16); color: #dfa864;
    border-radius: 50%; align-items: center; justify-content: center; font-size: .85rem;
  }
  .bl-footer__addr { color: rgba(243, 225, 198, .72); margin: .35rem 0 0; font-size: .85rem; }

  .bl-footer__bar { background: #1c0c05; border-top: 1px solid rgba(255, 255, 255, .06); }
  .bl-footer__bar-inner {
    width: min(1180px, 100%);
    margin: 0 auto;
    padding: .95rem 1.15rem;
    display: flex; flex-direction: column; gap: .75rem;
    align-items: center; text-align: center;
  }
  .bl-footer__pay { display: inline-flex; flex-wrap: wrap; justify-content: center; gap: .4rem; }
  .bl-pay {
    display: inline-flex; align-items: center; justify-content: center;
    padding: .35rem .75rem; border-radius: 8px;
    font-size: .72rem; font-weight: 900; letter-spacing: .06em;
    background: rgba(255, 255, 255, .05); color: #ffffff;
    border: 1px solid rgba(255, 255, 255, .09); min-height: 30px;
  }
  .bl-pay--cod   { background: #dfa864; color: #2a1408; border-color: transparent; }
  .bl-pay--visa  { background: #1a1f71; color: #ffffff; border-color: transparent; }
  .bl-pay--mc    { background: linear-gradient(90deg, #eb001b 0%, #f79e1b 100%); color: #ffffff; border-color: transparent; }
  .bl-pay--apple { background: #000000; color: #ffffff; border-color: transparent; }
  .bl-footer__copy { color: rgba(243, 225, 198, .62); margin: 0; font-size: .78rem; }

  @media (min-width: 750px) {
    .bl-footer__inner {
      grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
      gap: 2.5rem;
      padding: 3rem 1.15rem 2rem;
    }
    .bl-footer__bar-inner { flex-direction: row; justify-content: space-between; text-align: initial; }
  }
{% endstyle %}

{% schema %}
{
  "name": "Bloom UAE Footer",
  "tag": "section",
  "class": "bloom-uae-footer-wrapper",
  "settings": [
    { "type": "text", "id": "brand_name",      "label": "Brand (Arabic)",     "default": "بلوم كولاجين" },
    { "type": "text", "id": "brand_latin",     "label": "Brand (Latin)",      "default": "BLOOM COFFEE" },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number (no +)", "default": "971542585701" },
    { "type": "text", "id": "email",           "label": "Contact email",      "default": "contact@dr-sami.com" }
  ],
  "presets": [
    { "name": "Bloom UAE Footer", "category": "Footer" }
  ]
}
{% endschema %}
